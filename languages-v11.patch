+const DICTS: Record<Lang, Record<string, string>> = { 'en-US': en, 'en-GB': enGB, es, pt, fr, de, ja, zh, ko, ar, it, no, da, nl, sv, fi, ga, mi, ms, lb } as Record<Lang, Record<string, string>>;
 
