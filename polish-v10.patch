+/* Status text — one shared pair, theme-aware (plain CSS, not Tailwind:
+   the colour must flip with the theme, which a static utility cannot do).
+   Dark values are the familiar light red/green; in light mode they deepen
+   to red-600 / emerald-700 so a 12px message still clears AA on white. */
+.status-error { color: #f87171; }
+.status-ok { color: #4ade80; }
+:root[data-theme='light'] .status-error { color: #dc2626; }
+:root[data-theme='light'] .status-ok { color: #047857; }
+
+/* Secondary button — a quiet action beside a primary one. Used by the
+   notice-page email typo suggestions; previously undefined, so those
