+  justify-content: center;
+  gap: 0.5rem;
+  border: 1px solid rgb(var(--sc-line) / 0.25);
+  border-radius: 0.5rem;
+  background: rgb(var(--sc-surface));
+  color: rgb(var(--sc-text-soft));
+  cursor: pointer;
+  transition: border-color 0.2s ease, color 0.2s ease;
+}
+.btn-secondary:hover {
+  border-color: rgb(var(--sc-accent) / 0.5);
+  color: rgb(var(--sc-text));
+}
+.btn-secondary:focus-visible {
+  outline: 2px solid rgb(var(--sc-accent));
+  outline-offset: 2px;
+}
