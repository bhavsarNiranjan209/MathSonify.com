diff --git a/SoundCurve/certain-cycle/src/utils/lightAccent.test.ts b/SoundCurve/certain-cycle/src/utils/lightAccent.test.ts
new file mode 100644
index 0000000..be51396
--- /dev/null
+++ b/SoundCurve/certain-cycle/src/utils/lightAccent.test.ts
@@ -0,0 +1,36 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { darkenHex, lightAccent } from './lightAccent';
+import { GUESS_FAMILY_ACCENT } from '../data/guessLibrary';
+
+// WCAG relative luminance + contrast, so the test proves legibility rather
+// than pinning magic hex values.
+function luminance(hex: string): number {
+  const n = parseInt(hex.slice(1), 16);
+  const ch = [((n >> 16) & 0xff) / 255, ((n >> 8) & 0xff) / 255, (n & 0xff) / 255].map((c) =>
+    c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4),
+  );
+  return 0.2126 * ch[0] + 0.7152 * ch[1] + 0.0722 * ch[2];
+}
+function contrastOnWhite(hex: string): number {
+  return 1.05 / (luminance(hex) + 0.05);
+}
+
+test('darkenHex scales channels', () => {
+  assert.equal(darkenHex('#FFFFFF'), '#949494'); // 255 * 0.58 = 148
+  assert.equal(darkenHex('#000000'), '#000000');
+  assert.equal(darkenHex('not-a-color'), 'not-a-color');
+});
+
+test('every Guess family accent clears AA on white after darkening', () => {
+  for (const [family, accent] of Object.entries(GUESS_FAMILY_ACCENT)) {
+    const dark = darkenHex(accent);
+    const ratio = contrastOnWhite(dark);
+    assert.ok(ratio >= 4.5, `${family} ${accent} -> ${dark} is only ${ratio.toFixed(2)}:1 on white`);
+  }
+});
+
+test('lightAccent is a no-op in dark mode', () => {
+  // getThemeMode() returns 'dark' when document is undefined (node test env).
+  assert.equal(lightAccent('#E8B33C'), '#E8B33C');
+});
diff --git a/SoundCurve/certain-cycle/src/utils/lightAccent.ts b/SoundCurve/certain-cycle/src/utils/lightAccent.ts
new file mode 100644
index 0000000..2c68528
--- /dev/null
+++ b/SoundCurve/certain-cycle/src/utils/lightAccent.ts
@@ -0,0 +1,27 @@
+/**
+ * Light-mode legibility for data-driven accent colours.
+ *
+ * The Guess family accents are brand hues chosen for dark canvases; on a
+ * white canvas several of them fall to ~2:1. Rather than forking the data,
+ * callers pass the accent through `lightAccent()` at the point of use: in
+ * dark mode it returns the colour unchanged, in light mode a darkened
+ * version that clears AA against white.
+ */
+import { getThemeMode } from './theme';
+
+/** Multiplies each channel of a #RRGGBB hex by `factor` (0..1). */
+export function darkenHex(hex: string, factor = 0.58): string {
+  const m = /^#([0-9a-fA-F]{6})$/.exec(hex.trim());
+  if (!m) return hex;
+  const n = parseInt(m[1], 16);
+  const r = Math.round(((n >> 16) & 0xff) * factor);
+  const g = Math.round(((n >> 8) & 0xff) * factor);
+  const b = Math.round((n & 0xff) * factor);
+  const to = (v: number) => v.toString(16).padStart(2, '0');
+  return `#${to(r)}${to(g)}${to(b)}`;
+}
+
+/** The accent as it should be drawn in the current theme. */
+export function lightAccent(hex: string): string {
+  return getThemeMode() === 'light' ? darkenHex(hex) : hex;
+}
