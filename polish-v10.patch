+<script>
+  // Ambient particle field — the MusicLab background, for the SoundLab
+  // being-built page. Vanilla canvas, no island: this page ships no app
+  // JavaScript by design, and the field must stay that light. Colours are
+  // read from the computed --sc-* values, so it reads in white and dark.
+  (function () {
+    var canvas = document.getElementById('notice-ambient');
+    if (!canvas) return; // ambient not enabled on this page
+    var ctx = canvas.getContext('2d');
+    if (!ctx) return;
+    var reduced = false;
+    try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
+
+    var W = 0, H = 0, DPR = 1, frames = 0;
+    var accentCh = '201 162 75', faintCh = '138 133 120';
+
+    function cssVar(name, fallback) {
+      try {
+        var v = getComputedStyle(document.documentElement).getPropertyValue(name);
+        return (v && v.trim()) || fallback;
+      } catch (e) { return fallback; }
+    }
+    function withAlpha(ch, a) { return 'rgb(' + ch + ' / ' + a.toFixed(3) + ')'; }
+    function refreshColours() {
+      accentCh = cssVar('--sc-accent', accentCh);
+      faintCh = cssVar('--sc-text-faint', faintCh);
+    }
+
+    var parts = [];
+    function seed() {
+      parts = [];
+      for (var i = 0; i < 80; i++) {
+        var faint = Math.random() < 0.25;
+        parts.push({
+          x: Math.random(),
+          y: Math.random(),
+          vx: (Math.random() - 0.5) * 0.0003,
+          vy: (Math.random() - 0.5) * 0.0003,
+          size: 1 + Math.random() * 2,
+          base: 0.10 + Math.random() * 0.30,
+          phase: Math.random() * Math.PI * 2,
+          ch: faint ? faintCh : accentCh,
+        });
+      }
+    }
+
+    function resize() {
+      var parent = canvas.parentElement;
+      if (!parent) return;
+      var w = parent.clientWidth, h = parent.clientHeight;
+      var dpr = Math.min(2, Math.max(1, window.devicePixelRatio || 1));
+      var pw = Math.max(1, Math.floor(w * dpr));
+      var ph = Math.max(1, Math.floor(h * dpr));
+      if (canvas.width !== pw || canvas.height !== ph) {
+        canvas.width = pw; canvas.height = ph;
+        canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      }
+      W = w; H = h; DPR = dpr;
+    }
+
+    function draw(now) {
+      if (!W) return;
+      frames++;
+      if (frames % 300 === 0) refreshColours();
+      ctx.clearRect(0, 0, W, H);
+      for (var i = 0; i < parts.length; i++) {
+        var p = parts[i];
+        var a = p.base * (0.72 + 0.28 * Math.sin(now / 900 + p.phase));
+        ctx.fillStyle = withAlpha(p.ch, Math.max(0.02, a));
+        ctx.beginPath();
+        ctx.arc(p.x * W, p.y * H, p.size * DPR, 0, Math.PI * 2);
+        ctx.fill();
+      }
+    }
+
+    function step(k) {
+      for (var i = 0; i < parts.length; i++) {
+        var p = parts[i];
+        p.x += p.vx * k; p.y += p.vy * k;
+        if (p.x < 0) p.x = 1; if (p.x > 1) p.x = 0;
+        if (p.y < 0) p.y = 1; if (p.y > 1) p.y = 0;
+      }
+    }
+
+    var raf = 0, running = false, last = 0;
+    function frame(now) {
+      if (!running) return;
+      var dt = Math.min(50, now - last); last = now;
+      step(dt / 16.7);
+      draw(now);
+      raf = requestAnimationFrame(frame);
+    }
+
+    refreshColours();
+    resize();
+    seed();
+    if (reduced) { draw(0); return; }
+    running = true;
+    last = performance.now();
+    raf = requestAnimationFrame(frame);
+    window.addEventListener('resize', resize);
+    document.addEventListener('visibilitychange', function () {
+      if (document.hidden) {
+        running = false;
+        cancelAnimationFrame(raf);
+      } else if (!running) {
+        running = true;
+        last = performance.now();
+        raf = requestAnimationFrame(frame);
+      }
+    });
+  })();
+</script>
