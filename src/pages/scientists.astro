---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ScientistModal from '../components/ScientistModal';
import { SCIENTISTS, SCIENTIST_CATEGORIES } from '../data/scientists';
---

<BaseLayout title="Famous Scientists & Mathematicians - MathSonify" description="Explore the equations of history's greatest scientific and mathematical minds, and hear their legacies translated into sound.">
  <Navigation />

  <main class="min-h-screen pt-20 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sc-reveal">
      <div class="inline-flex items-center gap-2 px-3 py-1 border border-sc-accent/40 bg-sc-accent/15 rounded-full font-mono text-xs text-sc-accent mb-4" data-i18n="scientists.tag">
        hear the masters
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-sc-text tracking-tight mb-4" data-i18n="scientists.title">
        Famous Scientists & Mathematicians
      </h1>
      <p class="text-sm sm:text-base text-sc-text-soft leading-relaxed" data-i18n="scientists.subtitle">
        Explore the minds behind history's greatest equations and listen to their mathematical legacies translated into sound.
      </p>
    </div>

    <!-- Search bar -->
    <div class="max-w-md mx-auto mb-8 sc-reveal">
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sc-text-faint">🔍</span>
        <input
          type="text"
          id="scientist-search"
          placeholder="Search scientists..."
          class="w-full pl-10 pr-4 py-3 rounded-lg bg-sc-surface border border-sc-line/20 text-sm text-sc-text placeholder:text-sc-text-faint focus:outline-none focus:ring-2 focus:ring-sc-accent/50 focus:border-sc-accent transition-colors min-h-[44px]"
        />
      </div>
    </div>

    <!-- Category filter bar -->
    <div class="flex items-center justify-center gap-2 flex-wrap mb-10 sc-reveal">
      {SCIENTIST_CATEGORIES.map((cat) => (
        <button
          class="category-filter-btn px-4 py-2 rounded-full text-xs font-medium bg-sc-surface hover:bg-sc-accent/15 text-sc-text-soft hover:text-sc-text border border-sc-line/20 hover:border-sc-accent transition-colors min-h-[44px]"
          data-category={cat.id}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-sc-text-soft text-sm">No scientists found matching your search.</p>
    </div>

    <!-- Scientist card grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sc-reveal-stagger" id="scientists-grid">
      {SCIENTISTS.map((scientist) => (
        <button
          type="button"
          class="scientist-card panel p-5 hover:border-sc-accent/50 transition-colors duration-300 text-left cursor-pointer w-full flex flex-col gap-3"
          data-category={scientist.category}
          data-scientist-id={scientist.id}
          data-name={scientist.name.toLowerCase()}
        >
          <div class="flex items-start gap-3">
            <div
              class="w-12 h-12 rounded-full border border-sc-line/25 flex-shrink-0 flex items-center justify-center text-sm font-bold text-white"
              style={`background-color: ${scientist.color}`}
              aria-hidden="true"
            >
              {scientist.initials}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-serif text-lg font-semibold text-sc-text truncate">{scientist.name}</h3>
              <span class="text-xs font-mono text-sc-text-faint">{scientist.lifespan}</span>
            </div>
          </div>

          <p class="text-xs text-sc-text-soft italic leading-relaxed">
            "{scientist.tagline}"
          </p>

          <div class="mt-auto pt-3 border-t border-sc-line/15 flex items-center justify-between">
            <span class="text-[11px] font-mono text-sc-accent">
              {scientist.equations.length} <span data-i18n="scientists.equations">equations</span>
            </span>
            <span class="text-xs text-sc-text-soft group-hover:text-sc-accent transition-colors flex items-center gap-1" data-i18n="scientists.viewEquations">
              View Equations <span>→</span>
            </span>
          </div>
        </button>
      ))}
    </div>
  </main>

  <ScientistModal client:load />

  <Footer />
</BaseLayout>

<script>
  // Category filtering + search
  const filterBtns = document.querySelectorAll('.category-filter-btn');
  const cards = document.querySelectorAll('.scientist-card');
  const searchInput = document.getElementById('scientist-search') as HTMLInputElement;
  const noResults = document.getElementById('no-results');
  let activeCategory = 'all';
  let searchTerm = '';

  const ACTIVE = ['bg-sc-accent', 'text-sc-on-accent', 'border-sc-accent'];
  const IDLE = ['bg-sc-surface', 'text-sc-text-soft', 'border-sc-line/20', 'hover:bg-sc-accent/15', 'hover:text-sc-text', 'hover:border-sc-accent'];

  function setActive(btn: Element) {
    filterBtns.forEach((b) => {
      b.classList.remove(...ACTIVE);
      b.classList.add(...IDLE);
    });
    btn.classList.remove(...IDLE);
    btn.classList.add(...ACTIVE);
  }

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const cardCat = card.getAttribute('data-category');
      const text = (card as HTMLElement).textContent?.toLowerCase() || '';
      const matchesCat = activeCategory === 'all' || cardCat === activeCategory;
      const matchesSearch = !searchTerm || text.includes(searchTerm);
      const show = matchesCat && matchesSearch;
      (card as HTMLElement).style.display = show ? 'flex' : 'none';
      if (show) visible++;
    });
    if (noResults) noResults.classList.toggle('hidden', visible > 0);
  }

  if (filterBtns[0]) setActive(filterBtns[0]);

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.getAttribute('data-category') || 'all';
      setActive(btn);
      applyFilters();
    });
  });

  // Search filtering
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchTerm = searchInput.value.trim().toLowerCase();
      applyFilters();
    });
  }

  // Card click → open modal via custom event
  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-scientist-id');
      if (id) {
        window.dispatchEvent(new CustomEvent('mathsonify:open-scientist', { detail: id }));
      }
    });
  });
</script>
</BaseLayout>
