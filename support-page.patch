diff --git a/SoundCurve/certain-cycle/src/pages/support.astro b/SoundCurve/certain-cycle/src/pages/support.astro
new file mode 100644
index 0000000..377f049
--- /dev/null
+++ b/SoundCurve/certain-cycle/src/pages/support.astro
@@ -0,0 +1,538 @@
+---
+import BaseLayout from '../layouts/BaseLayout.astro';
+import Navigation from '../components/Navigation.astro';
+import Footer from '../components/Footer.astro';
+import { SUPPORT } from '../config/support';
+import { formatUSD, buildDonateUrl } from '../lib/supportAmount';
+import { CONTACT_EMAIL } from '../utils/productConfig';
+
+const donateUrl = SUPPORT.donateUrl;
+const story =
+  SUPPORT.story ||
+  'MathSonify started with one question: what does an equation sound like? Everything here is free. If it changed how you hear maths, a coffee keeps it that way.';
+const defaultAmount = 10;
+const initialDonateUrl = donateUrl ? buildDonateUrl(donateUrl, defaultAmount) : null;
+---
+
+<BaseLayout
+  title="Support MathSonify"
+  description="MathSonify is free — no ads, no tracking, no paywall. If it changed how you hear maths, a coffee keeps it that way."
+>
+  <Navigation />
+
+  <main class="min-h-screen pt-20 pb-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto relative overflow-x-hidden">
+    <!-- warm glow -->
+    <div
+      aria-hidden="true"
+      class="pointer-events-none absolute left-1/2 top-10 h-[560px] w-[820px] max-w-[100vw] -translate-x-1/2"
+      style="background: radial-gradient(closest-side, rgba(201,162,75,.17), rgba(201,162,75,.05) 55%, transparent 75%)"
+    ></div>
+
+    <div class="relative">
+      <!-- Hero -->
+      <section class="text-center">
+        <span class="mb-[18px] inline-flex rounded-full border border-sc-line/15 px-3.5 py-1.5 font-mono text-[11px] text-sc-text-soft">support</span>
+        <h1 class="mx-auto mb-3.5 font-serif text-[clamp(36px,6.4vw,62px)] font-normal leading-[1.04] text-sc-text">
+          Help keep the <em>music</em> playing
+        </h1>
+        <p class="mx-auto max-w-[50ch] text-[clamp(15px,2vw,17px)] leading-[1.65] text-sc-text-soft">{story}</p>
+
+        <!-- Cup: steam canvas + coffee SVG. Fill level is driven by the amount. -->
+        <div class="cupwrap relative mx-auto mt-[22px] h-[262px] w-[260px]">
+          <canvas id="steam" width="520" height="380" aria-hidden="true" class="pointer-events-none absolute left-0 top-0 h-[190px] w-[260px]"></canvas>
+          <svg viewBox="0 0 188 128" aria-hidden="true" class="absolute left-9 top-[130px] h-[128px] w-[188px] overflow-visible">
+            <defs>
+              <clipPath id="inner"><path d="M30 24h116v42a46 46 0 0 1-46 46h-24a46 46 0 0 1-46-46z"></path></clipPath>
+            </defs>
+            <ellipse cx="94" cy="118" rx="88" ry="9" fill="#1b1c20" stroke="#2A2A30"></ellipse>
+            <g clip-path="url(#inner)">
+              <rect id="coffee" x="20" y="24" width="140" height="100" fill="#3b2410" style="transform: translateY(70px)"></rect>
+              <rect id="crema" x="20" y="24" width="140" height="6" fill="#F5A623" opacity=".35" style="transform: translateY(70px)"></rect>
+            </g>
+            <path d="M30 24h116v42a46 46 0 0 1-46 46h-24a46 46 0 0 1-46-46z" fill="none" stroke="#4a4b53" stroke-width="2"></path>
+            <path d="M146 38h10a17 17 0 0 1 0 34h-14" fill="none" stroke="#4a4b53" stroke-width="2"></path>
+            <text x="88" y="78" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="11" style="fill: rgb(var(--sc-text-soft)); fill-opacity: .75;">y = sin(x)</text>
+          </svg>
+        </div>
+      </section>
+
+      <!-- Pay card -->
+      <div id="pay" class="mx-auto mt-1.5 max-w-[640px] rounded-[22px] border border-sc-line/15 bg-gradient-to-b from-white/[.045] to-white/[.012] p-[22px] shadow-[0_30px_80px_-40px_rgba(201,162,75,.45)] max-sm:p-4">
+        <div id="tiers" class="grid grid-cols-3 gap-2.5" role="group" aria-label="Choose a size">
+          {
+            SUPPORT.tiers.map((tier) => (
+              <button
+                type="button"
+                class:list={['tier', { pop: tier.popular }]}
+                data-v={tier.amount}
+                aria-pressed="false"
+              >
+                <span class="tier-emoji">{tier.emoji}</span>
+                <b>{tier.name}</b>
+                <span class="tier-price">{formatUSD(tier.amount)}</span>
+                <span class="tier-note">{tier.note}</span>
+              </button>
+            ))
+          }
+        </div>
+
+        <div class="my-[18px] flex items-center gap-2.5 text-xs text-sc-text-soft">
+          <span class="h-px flex-1 bg-sc-line/15"></span>
+          or choose your own amount
+          <span class="h-px flex-1 bg-sc-line/15"></span>
+        </div>
+
+        <div id="chips" class="flex flex-wrap justify-center gap-2" role="group" aria-label="Quick amounts">
+          {
+            SUPPORT.quickAmounts.map((v) => (
+              <button type="button" class="chip" data-v={v} aria-pressed="false">
+                {formatUSD(v)}
+              </button>
+            ))
+          }
+        </div>
+
+        <label id="customBox" class="custom mt-3.5 flex items-center rounded-[14px] border border-sc-line/15 bg-sc-sunken px-3.5">
+          <span class="font-mono text-xl text-sc-text-soft">$</span>
+          <input
+            id="amt"
+            inputmode="decimal"
+            autocomplete="off"
+            aria-label="Amount in US dollars"
+            placeholder="Any amount"
+            class="min-w-0 flex-1 border-0 bg-transparent px-2 py-[15px] font-mono text-[22px] text-sc-text outline-0"
+          />
+          <small class="whitespace-nowrap text-[11.5px] text-sc-text-soft">USD · {formatUSD(SUPPORT.min)} – {formatUSD(SUPPORT.max)}</small>
+        </label>
+        <div id="err" class="err min-h-[20px] text-[12.5px]" role="status" aria-live="polite"></div>
+
+        <div class="mx-1 mb-3 mt-2.5 flex items-baseline justify-between">
+          <span class="text-[13px] text-sc-text-soft">Your support</span>
+          <b id="total" class="font-serif text-[44px] font-normal leading-none text-sc-text tabular-nums">{formatUSD(defaultAmount)}</b>
+        </div>
+
+        {
+          initialDonateUrl ? (
+            <a
+              id="cta"
+              href={initialDonateUrl}
+              target="_blank"
+              rel="noopener noreferrer"
+              class="cta flex w-full items-center justify-center gap-2.5 rounded-[14px] border-0 bg-sc-accent px-4 py-[17px] text-base font-semibold text-sc-on-accent shadow-[0_12px_36px_-14px_rgba(201,162,75,.7)] transition hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white"
+            >
+              Continue to secure payment <span aria-hidden="true">→</span>
+            </a>
+          ) : (
+            <p class="rounded-[14px] border border-dashed border-sc-line/15 px-4 py-3.5 text-center text-[13px] leading-relaxed text-sc-text-soft">
+              Secure payment opens soon — we&rsquo;re connecting a donation platform that accepts custom amounts and
+              international cards. Pick an amount above and it will be ready when you are.
+            </p>
+          )
+        }
+
+        {
+          donateUrl && (
+            <div class="mt-3.5 flex flex-wrap justify-center gap-1.5">
+              {SUPPORT.methods.map((m) => (
+                <span class="rounded-lg border border-sc-line/15 bg-sc-surface px-2.5 py-1 font-mono text-[10.5px] text-sc-text-soft">{m}</span>
+              ))}
+            </div>
+            <p class="mt-2.5 text-center text-[11.5px] leading-[1.55] text-sc-text-soft">
+              🔒 Payment is handled by our payment partner — we never see your card or bank details.
+            </p>
+          )
+        }
+      </div>
+
+      <!-- Where it goes -->
+      <h2 class="mb-1.5 mt-14 text-center font-serif text-3xl font-normal text-sc-text">Where it goes</h2>
+      <p class="mx-auto mb-[22px] max-w-[52ch] text-center text-sm leading-relaxed text-sc-text-soft">
+        No ads, no tracking, no paywall on the core experience. Support goes to three honest things:
+      </p>
+      <div class="grid grid-cols-3 gap-3 max-md:grid-cols-1">
+        <div class="rounded-2xl border border-sc-line/15 bg-sc-surface p-5 transition hover:-translate-y-[3px] hover:border-sc-line/40">
+          <div class="mb-3 grid h-[38px] w-[38px] place-items-center rounded-[10px] border border-sc-line/15 bg-sc-sunken text-lg">🌐</div>
+          <b class="mb-1 block text-[14.5px] text-sc-text">The domain</b>
+          <p class="m-0 text-[13px] leading-relaxed text-sc-text-soft">mathsonify.com renews every year.</p>
+        </div>
+        <div class="rounded-2xl border border-sc-line/15 bg-sc-surface p-5 transition hover:-translate-y-[3px] hover:border-sc-line/40">
+          <div class="mb-3 grid h-[38px] w-[38px] place-items-center rounded-[10px] border border-sc-line/15 bg-sc-sunken text-lg">🖥</div>
+          <b class="mb-1 block text-[14.5px] text-sc-text">Hosting and email</b>
+          <p class="m-0 text-[13px] leading-relaxed text-sc-text-soft">The servers, and the service that tells you when SoundLab and Music Lab open.</p>
+        </div>
+        <div class="rounded-2xl border border-sc-line/15 bg-sc-surface p-5 transition hover:-translate-y-[3px] hover:border-sc-line/40">
+          <div class="mb-3 grid h-[38px] w-[38px] place-items-center rounded-[10px] border border-sc-line/15 bg-sc-sunken text-lg">🛠</div>
+          <b class="mb-1 block text-[14.5px] text-sc-text">Time to build</b>
+          <p class="m-0 text-[13px] leading-relaxed text-sc-text-soft">New equations, new instruments and fixes — shaped by what people ask for.</p>
+        </div>
+      </div>
+      <div class="mx-auto mt-4 max-w-[640px] rounded-[14px] border border-dashed border-sc-line/15 px-4 py-3.5 text-center text-[13px] leading-relaxed text-sc-text-soft">
+        <b class="text-sc-text">Support does not unlock anything.</b> Donations are voluntary gifts, not purchases. Everything you can use today stays free.
+      </div>
+
+      <!-- Free ways to help -->
+      <h2 class="mb-1.5 mt-14 text-center font-serif text-3xl font-normal text-sc-text">Can&rsquo;t donate? These help just as much</h2>
+      <p class="mx-auto mb-[22px] max-w-[52ch] text-center text-sm leading-relaxed text-sc-text-soft">Honestly, they might help more.</p>
+      <div class="grid grid-cols-3 gap-3 max-md:grid-cols-1">
+        <button
+          id="share"
+          type="button"
+          class="flex w-full items-center justify-center gap-2 rounded-xl border border-sc-line/15 bg-sc-surface px-[18px] py-3.5 text-[14.5px] font-semibold text-sc-text transition hover:-translate-y-0.5 hover:border-sc-line/40 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white"
+        >
+          ↗ Share MathSonify
+        </button>
+        <a
+          href="/contact"
+          class="flex w-full items-center justify-center gap-2 rounded-xl border border-sc-line/15 bg-sc-surface px-[18px] py-3.5 text-[14.5px] font-semibold text-sc-text transition hover:-translate-y-0.5 hover:border-sc-line/40 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white"
+        >
+          ∑ Suggest an equation
+        </a>
+        <a
+          href="/guess"
+          class="flex w-full items-center justify-center gap-2 rounded-xl border border-sc-line/15 bg-sc-surface px-[18px] py-3.5 text-[14.5px] font-semibold text-sc-text transition hover:-translate-y-0.5 hover:border-sc-line/40 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white"
+        >
+          🎧 Challenge a friend in Guess
+        </a>
+      </div>
+
+      <p class="mx-auto mt-11 max-w-[640px] text-center text-xs leading-[1.7] text-sc-text-soft">
+        Support is voluntary and does not unlock features. Payment is processed by a third party whose privacy policy
+        applies there. Questions? <a href={`mailto:${CONTACT_EMAIL}`} class="text-sc-text underline underline-offset-2">{CONTACT_EMAIL}</a> · <a href="/privacy" class="text-sc-text underline underline-offset-2">Privacy</a> · <a href="/terms" class="text-sc-text underline underline-offset-2">Terms</a>
+      </p>
+    </div>
+  </main>
+
+  <Footer />
+
+  {
+    initialDonateUrl && (
+      <div id="sticky" class="sticky fixed inset-x-0 bottom-0 z-[5] hidden items-center gap-3 border-t border-sc-line/15 bg-sc-bg/90 px-3.5 pb-[calc(10px+env(safe-area-inset-bottom))] pt-2.5 backdrop-blur-[14px] max-md:flex">
+        <b id="stTotal" class="min-w-[76px] font-serif text-[28px] font-normal text-sc-text">{formatUSD(defaultAmount)}</b>
+        <a
+          id="stCta"
+          href={initialDonateUrl}
+          target="_blank"
+          rel="noopener noreferrer"
+          class="cta flex w-full items-center justify-center gap-2.5 rounded-[14px] border-0 bg-sc-accent px-4 py-3.5 text-base font-semibold text-sc-on-accent shadow-[0_12px_36px_-14px_rgba(201,162,75,.7)] transition hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white"
+        >
+          Continue to payment →
+        </a>
+      </div>
+    )
+  }
+  <div id="toast" class="toast fixed bottom-[90px] left-1/2 z-[9] max-w-[90vw] -translate-x-1/2 translate-y-5 rounded-[10px] bg-sc-accent px-4 py-2.5 text-center text-[13px] font-semibold text-sc-on-accent opacity-0 transition" role="status" aria-live="polite"></div>
+
+  <script define:vars={{ donateUrl, min: SUPPORT.min, max: SUPPORT.max }}>
+    import { parseAmount, formatUSD, buildDonateUrl, cupLevel } from '../lib/supportAmount';
+
+    const $ = (s) => document.querySelector(s);
+    const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
+    const hasPayment = Boolean(donateUrl);
+
+    let amount = 10;
+    let shown = 10;
+    let anim = 0;
+
+    const toast = (m) => {
+      const t = $('#toast');
+      t.textContent = m;
+      t.classList.add('on');
+      clearTimeout(toast.t);
+      toast.t = setTimeout(() => t.classList.remove('on'), 2200);
+    };
+
+    /* A soft chord, only ever on a click — never on load, never while typing. */
+    let audioCtx = null;
+    function playChord() {
+      try {
+        audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
+        if (audioCtx.state === 'suspended') void audioCtx.resume();
+        const now = audioCtx.currentTime;
+        [261.63, 329.63, 392.0].forEach((f) => {
+          const o = audioCtx.createOscillator();
+          const g = audioCtx.createGain();
+          o.type = 'triangle';
+          o.frequency.value = f;
+          g.gain.setValueAtTime(0.0001, now);
+          g.gain.exponentialRampToValueAtTime(0.05, now + 0.02);
+          g.gain.exponentialRampToValueAtTime(0.0001, now + 1.4);
+          o.connect(g);
+          g.connect(audioCtx.destination);
+          o.start(now);
+          o.stop(now + 1.5);
+        });
+      } catch {
+        /* audio is a garnish — it must never break the page */
+      }
+    }
+
+    /* Cup fill + steam particles. */
+    let parts = [];
+    let tgtLevel = cupLevel(10);
+    function setCup() {
+      const l = cupLevel(Math.min(Math.max(amount || 5, 5), 1e6));
+      tgtLevel = l;
+      const y = 100 * (1 - l) + 6;
+      const coffee = $('#coffee');
+      const crema = $('#crema');
+      if (coffee) coffee.style.transform = 'translateY(' + y + 'px)';
+      if (crema) crema.style.transform = 'translateY(' + y + 'px)';
+    }
+    function burst(n) {
+      if (RM) return;
+      for (let i = 0; i < n; i++)
+        parts.push({ x: 130 + (Math.random() - 0.5) * 90, y: 190, vx: (Math.random() - 0.5) * 1.2, vy: -1.2 - Math.random() * 2.4, l: 1, s: 2 + Math.random() * 3 });
+    }
+
+    function syncCtas() {
+      const url = amount === null ? null : hasPayment ? buildDonateUrl(donateUrl, amount) : null;
+      ['#cta', '#stCta'].forEach((sel) => {
+        const a = $(sel);
+        if (!a) return;
+        if (url) {
+          a.href = url;
+          a.removeAttribute('aria-disabled');
+          a.classList.remove('cta-off');
+        } else {
+          a.setAttribute('aria-disabled', 'true');
+          a.classList.add('cta-off');
+        }
+      });
+    }
+
+    function render() {
+      const ok = amount !== null;
+      const v = ok ? amount : null;
+      document.querySelectorAll('.tier').forEach((b) => b.setAttribute('aria-pressed', String(ok && +b.dataset.v === v)));
+      document.querySelectorAll('.chip').forEach((b) => b.setAttribute('aria-pressed', String(ok && +b.dataset.v === v)));
+      syncCtas();
+      const to = ok ? v : shown;
+      cancelAnimationFrame(anim);
+      const from = shown;
+      const t0 = performance.now();
+      const step = (t) => {
+        const k = RM ? 1 : Math.min(1, (t - t0) / 450);
+        const e = 1 - Math.pow(1 - k, 3);
+        shown = from + (to - from) * e;
+        const txt = ok ? formatUSD(Math.round(shown * 100) / 100) : '—';
+        const total = $('#total');
+        const stTotal = $('#stTotal');
+        if (total) total.textContent = txt;
+        if (stTotal) stTotal.textContent = txt;
+        if (k < 1) anim = requestAnimationFrame(step);
+      };
+      anim = requestAnimationFrame(step);
+      if (ok) setCup();
+    }
+
+    function note() {
+      const err = $('#err');
+      if (amount >= 1000) {
+        err.className = 'err note';
+        err.textContent = 'Thank you — that is generous. Large gifts may need extra verification from your payment provider.';
+      }
+    }
+
+    function pick(v) {
+      const r = parseAmount(v);
+      amount = r.ok ? r.dollars : null;
+      const amt = $('#amt');
+      if (amt) amt.value = String(v);
+      const err = $('#err');
+      err.textContent = '';
+      err.className = 'err';
+      $('#customBox').classList.remove('bad');
+      note();
+      burst(10 + Math.round(cupLevel(v) * 30));
+      playChord();
+      render();
+    }
+
+    document.querySelectorAll('.tier').forEach((b) => b.addEventListener('click', () => pick(+b.dataset.v)));
+    document.querySelectorAll('.chip').forEach((b) => b.addEventListener('click', () => pick(+b.dataset.v)));
+
+    const amtInput = $('#amt');
+    amtInput.addEventListener('input', (e) => {
+      const raw = e.target.value;
+      const err = $('#err');
+      if (!raw.trim()) {
+        amount = null;
+        err.textContent = 'Enter an amount, or pick one above.';
+        err.className = 'err';
+        $('#customBox').classList.remove('bad');
+        render();
+        return;
+      }
+      const r = parseAmount(raw);
+      if (r.ok) {
+        amount = r.dollars;
+        err.textContent = '';
+        err.className = 'err';
+        $('#customBox').classList.remove('bad');
+        note();
+        burst(4);
+      } else {
+        amount = null;
+        err.textContent = r.error;
+        err.className = 'err';
+        $('#customBox').classList.add('bad');
+      }
+      render();
+    });
+
+    /* Pay CTAs: never navigate with no valid amount. */
+    ['#cta', '#stCta'].forEach((sel) => {
+      const a = $(sel);
+      if (!a) return;
+      a.addEventListener('click', (e) => {
+        if (amount === null || !hasPayment || !buildDonateUrl(donateUrl, amount)) {
+          e.preventDefault();
+          toast('Pick an amount first.');
+        }
+      });
+    });
+
+    /* Share. */
+    const shareBtn = $('#share');
+    if (shareBtn)
+      shareBtn.addEventListener('click', async () => {
+        const u = 'https://mathsonify.com';
+        try {
+          if (navigator.share) await navigator.share({ title: 'MathSonify', text: 'Type an equation, hear it.', url: u });
+          else {
+            await navigator.clipboard.writeText(u);
+            toast('Link copied');
+          }
+        } catch (e) {
+          /* user cancelled the share sheet — nothing to do */
+        }
+      });
+
+    /* Sticky pay bar: show once the pay card scrolls out of view (only when payment exists). */
+    const sticky = $('#sticky');
+    const pay = $('#pay');
+    if (sticky && pay) new IntersectionObserver((e) => sticky.classList.toggle('on', !e[0].isIntersecting), { threshold: 0 }).observe(pay);
+
+    /* Steam: warm amber wisps, paused off-screen, one static frame under reduced motion. */
+    const cv = $('#steam');
+    const ctx = cv.getContext('2d');
+    let vis = true;
+    new IntersectionObserver((e) => (vis = e[0].isIntersecting)).observe(cv);
+    let cur = cupLevel(10);
+    function frame(t) {
+      if (vis || RM) {
+        cur += (tgtLevel - cur) * 0.06;
+        ctx.clearRect(0, 0, 520, 380);
+        const amp = 0.7 + cur * 1.1;
+        const n = cur > 0.8 ? 5 : 3;
+        for (let i = 0; i < n; i++) {
+          const cx = 190 + i * (140 / (n - 1 || 1)) + (n === 5 ? 0 : 30);
+          const ph = i * 2.1;
+          const sp = 0.9 + i * 0.12;
+          const g = ctx.createLinearGradient(0, 360, 0, 0);
+          g.addColorStop(0, 'rgba(201,162,75,0)');
+          g.addColorStop(0.25, 'rgba(201,162,75,' + (0.35 + cur * 0.4) + ')');
+          g.addColorStop(1, 'rgba(255,255,255,0)');
+          ctx.strokeStyle = g;
+          ctx.lineWidth = 3;
+          ctx.lineCap = 'round';
+          ctx.beginPath();
+          for (let y = 360; y >= 10; y -= 4) {
+            const k = (360 - y) / 350;
+            const a = (10 + k * 16) * amp;
+            const x = cx + Math.sin(y * 0.045 + ph + (RM ? 0 : (t / 1000) * sp * 2.2)) * a * k;
+            y === 360 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
+          }
+          ctx.stroke();
+        }
+        parts = parts.filter((p) => p.l > 0);
+        for (const p of parts) {
+          p.x += p.vx;
+          p.y += p.vy;
+          p.vy += 0.012;
+          p.l -= 0.012;
+          ctx.fillStyle = 'rgba(201,162,75,' + Math.max(0, p.l) + ')';
+          ctx.beginPath();
+          ctx.arc(p.x, p.y, p.s, 0, 6.283);
+          ctx.fill();
+        }
+      }
+      if (!RM) requestAnimationFrame(frame);
+    }
+    requestAnimationFrame(frame);
+
+    pick(10);
+  </script>
+
