---
import { getVisibleNavLinks, isFeatureEnabled, type FeatureId } from '../config/featureFlags';

// Every public nav item, with the feature that controls it. `feature: null`
// means the link is always public. The three unreleased experiences are listed
// here and filtered out in one place, so no gap or placeholder is left behind.
const allNavLinks: { name: string; href: string; feature: FeatureId | null; i18nKey: string }[] = [
  { name: 'SoundLab', href: '/soundlab', feature: 'soundLab', i18nKey: 'nav.soundlab' },
  { name: 'How It Works', href: '/how-it-works', feature: null, i18nKey: 'nav.howItWorks' },
  { name: 'Studio', href: '/studio', feature: null, i18nKey: 'nav.studio' },
  { name: 'Guess', href: '/guess', feature: null, i18nKey: 'nav.guess' },
  { name: 'Draw', href: '/draw', feature: 'draw', i18nKey: 'nav.draw' },
  { name: 'Scientists', href: '/scientists', feature: null, i18nKey: 'nav.scientists' },
  { name: 'Equations', href: '/equations', feature: null, i18nKey: 'nav.equations' },
  { name: 'Music Lab', href: '/music-lab', feature: 'musicLab', i18nKey: 'nav.musicLab' },
  { name: 'About', href: '/about', feature: null, i18nKey: 'nav.about' },
  { name: 'Support', href: '/support', feature: null, i18nKey: 'nav.support' },
];

// Release-controlled links are removed from the array entirely, so an
// unreleased feature leaves no empty space and no hidden DOM.
const navLinks = getVisibleNavLinks(allNavLinks);

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isCurrent(href: string) {
  return currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
}
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-sc-bg border-b border-sc-line/15">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <!-- Wordmark -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-2 group/nav">
          <img src="/favicon.jpeg" alt="MathSonify" class="h-8 w-8 rounded-full object-cover border border-sc-line/20 transition-transform duration-300 group-hover/nav:scale-110 group-hover/nav:rotate-[8deg]" loading="eager" />
          <span class="text-lg font-bold text-sc-text tracking-tight transition-colors duration-300 group-hover/nav:text-sc-accent" style="font-family: 'Space Grotesk', sans-serif;">MathSonify.com</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center space-x-5">
        {navLinks.map((link) => link.name === 'SoundLab' ? (
          <a
            href={link.href}
            class:list={[
              'nav-soundlab relative text-sm font-semibold transition-opacity',
              { 'nav-current': isCurrent(link.href) },
            ]}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            data-i18n="nav.soundlab"
          >
            <span class="nav-soundlab-text">{link.name}</span>
          </a>
        ) : link.name === 'Music Lab' ? (
          <a
            href={link.href}
            class:list={[
              'nav-musiclab relative text-sm font-semibold transition-opacity',
              { 'nav-current': isCurrent(link.href) },
            ]}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            data-i18n="nav.musicLab"
          >
            <span class="nav-musiclab-text">{link.name}</span>
            <span class="nav-musiclab-glow" aria-hidden="true"></span>
          </a>
        ) : link.name === 'Studio' ? (
          // `data-i18n` sits on the inner span, not the <a>: applyStaticTranslations
          // assigns `textContent`, which would otherwise replace the anchor's
          // children and destroy the glow span on the first language switch.
          <a
            href={link.href}
            class:list={[
              'nav-studio relative text-sm font-semibold transition-opacity',
              { 'nav-current': isCurrent(link.href) },
            ]}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            <span class="nav-studio-text" data-i18n={link.i18nKey}>{link.name}</span>
          </a>
        ) : (
          <a
            href={link.href}
            class:list={[
              'relative text-sm transition-colors',
              isCurrent(link.href) ? 'nav-current text-sc-text font-semibold' : 'text-sc-text-soft hover:text-sc-text',
            ]}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
            data-i18n={link.i18nKey}
          >
            {link.name}
          </a>
        ))}
      </div>

      <!-- Right Side -->
      <div class="flex items-center space-x-3">
        <!-- Mode Selector: Light / Dark -->
        <div
          id="mode-selector"
          role="group"
          aria-label="Display mode"
          class:list={[
            'hidden items-center p-0.5 border border-sc-line/20 rounded-full bg-sc-surface',
            { 'sm:flex': currentPath !== '/draw' },
          ]}
        >
          <button
            type="button"
            data-mode="light"
            class="mode-option px-3 py-1 text-xs font-medium rounded-full transition-colors"
            data-i18n="nav.light"
          >
            Light
          </button>
          <button
            type="button"
            data-mode="dark"
            class="mode-option px-3 py-1 text-xs font-medium rounded-full transition-colors"
            data-i18n="nav.dark"
          >
            Dark
          </button>
        </div>

        <!-- Language Switcher (desktop) -->
        <div id="lang-switcher" class="relative hidden sm:block">
          <button
            id="lang-switcher-trigger"
            type="button"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-sc-line/20 bg-sc-surface hover:bg-sc-surface/80 transition-colors"
            aria-haspopup="menu"
            aria-expanded="false"
            title="Change language"
          >
            <span aria-hidden="true" class="text-sm leading-none">🌐</span>
            <span id="lang-code" class="text-xs font-mono font-semibold text-sc-text">EN</span>
            <svg class="w-3 h-3 text-sc-text-faint shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div
            id="lang-switcher-menu"
            role="menu"
            class="hidden absolute right-0 top-full mt-1.5 py-1.5 min-w-[170px] panel shadow-lg z-50 max-h-72 overflow-y-auto"
          >
            <!-- populated by JS -->
          </div>
        </div>

        <!-- Mobile Menu Toggle -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden p-2 rounded-md hover:bg-sc-surface transition-colors"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg id="mobile-menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="mobile-menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-sc-line/15 bg-sc-bg">
    <div class="px-4 py-4 space-y-3">
      {navLinks.map((link) => link.name === 'SoundLab' ? (
        <a
          href={link.href}
          class:list={[
            'block nav-soundlab relative text-sm font-semibold',
            { 'nav-current': isCurrent(link.href) },
          ]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          data-i18n={link.i18nKey}
        >
          <span class="nav-soundlab-text">{link.name}</span>
        </a>
      ) : link.name === 'Music Lab' ? (
        <a
          href={link.href}
          class:list={[
            'block nav-musiclab relative text-sm font-semibold',
            { 'nav-current': isCurrent(link.href) },
          ]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          data-i18n="nav.musicLab"
        >
          <span class="nav-musiclab-text">{link.name}</span>
        </a>
      ) : link.name === 'Studio' ? (
        <a
          href={link.href}
          class:list={[
            'block nav-studio relative text-sm font-semibold',
            { 'nav-current': isCurrent(link.href) },
          ]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
        >
          <span class="nav-studio-text" data-i18n={link.i18nKey}>{link.name}</span>
        </a>
      ) : (
        <a
          href={link.href}
          class:list={[
            'block relative transition-colors',
            isCurrent(link.href) ? 'nav-current text-sc-text font-semibold' : 'text-sc-text-soft hover:text-sc-text',
          ]}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          data-i18n={link.i18nKey}
        >
          {link.name}
        </a>
      ))}
      <div class:list={['pt-3 border-t border-sc-line/15', { hidden: currentPath === '/draw' }]}>
        <div class="text-xs text-sc-text-faint mb-2" data-i18n="nav.displayMode">Display mode</div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            data-mode="light"
            class="mode-option px-3 py-1 text-xs font-medium rounded-full border border-sc-line/20 transition-colors"
            data-i18n="nav.light"
          >
            Light
          </button>
          <button
            type="button"
            data-mode="dark"
            class="mode-option px-3 py-1 text-xs font-medium rounded-full border border-sc-line/20 transition-colors"
            data-i18n="nav.dark"
          >
            Dark
          </button>
        </div>
      </div>
      <!-- Language switcher (mobile) -->
      <div class="pt-3 border-t border-sc-line/15">
        <div class="text-xs text-sc-text-faint mb-2" data-i18n="nav.language">Language</div>
        <div id="lang-switcher-mobile" class="flex flex-wrap gap-1.5">
          <!-- populated by JS -->
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  import { getLang, setLang, applyStaticTranslations, LANGUAGES } from '../i18n/index';

  // ── Theme (unchanged) ──
  const THEME_KEY = 'mathsonify-theme';
  const THEME_CHANGE_EVENT = 'mathsonify:themechange';

  function currentTheme() {
    var stored = document.documentElement.dataset.theme;
    if (stored === 'digital') stored = 'light';
    if (stored === 'mono') stored = 'dark';
    return stored === 'light' || stored === 'dark' ? stored : 'dark';
  }

  function applyTheme(mode) {
    document.documentElement.dataset.theme = mode;
    try {
      localStorage.setItem(THEME_KEY, mode);
    } catch (e) {
      /* storage unavailable — stay quiet */
    }
    window.dispatchEvent(new CustomEvent(THEME_CHANGE_EVENT, { detail: mode }));

    document.querySelectorAll('.mode-option').forEach((btn) => {
      const isActive = btn.dataset.mode === mode;
      btn.classList.toggle('bg-sc-accent', isActive);
      btn.classList.toggle('text-sc-on-accent', isActive);
      btn.classList.toggle('border-sc-accent', isActive);
      btn.classList.toggle('text-sc-text_soft', !isActive);
    });
  }

  // Wire up selectors
  document.querySelectorAll('.mode-option').forEach((btn) => {
    btn.addEventListener('click', () => applyTheme(btn.dataset.mode));
  });

  // Paint the current state
  applyTheme(currentTheme());

  // Mobile menu toggle
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuIconOpen = document.getElementById('mobile-menu-icon-open');
  const mobileMenuIconClose = document.getElementById('mobile-menu-icon-close');

  /** Drive open/close from a single source of truth so scroll lock, icons and
   * aria state can never drift apart. */
  function setMobileMenu(open: boolean) {
    if (!mobileMenu || !mobileMenuToggle) return;
    mobileMenu.classList.toggle('hidden', !open);
    mobileMenuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    mobileMenuIconOpen?.classList.toggle('hidden', open);
    mobileMenuIconClose?.classList.toggle('hidden', !open);
    // Lock background scroll while open; never leave it stuck.
    document.body.style.overflow = open ? 'hidden' : '';
  }

  function closeMobileMenu() {
    setMobileMenu(false);
  }

  mobileMenuToggle?.addEventListener('click', () => {
    setMobileMenu(mobileMenu?.classList.contains('hidden') ?? false);
  });

  // Tapping any nav link inside the menu dismisses it — including links to the
  // page you are already on, which the browser does not reload.
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMobileMenu);
  });

  // Clicking outside the nav dismisses an open menu.
  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!mobileMenu || mobileMenu.classList.contains('hidden')) return;
    if (target?.closest?.('#mobile-menu') || target?.closest?.('#mobile-menu-toggle')) return;
    closeMobileMenu();
  });

  // Escape dismisses the menu (parity with the language dropdown).
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
      closeMobileMenu();
      mobileMenuToggle?.focus();
    }
  });

  // Crossing into the desktop breakpoint hides the menu via `md:hidden` — clear
  // the inline scroll lock too so the page is never frozen.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) closeMobileMenu();
  });

  // Reset on every Astro navigation. A no-op for today's full-page loads, but
  // keeps the mobile menu correct if the site later adopts client-side routing.
  document.addEventListener('astro:page-load', closeMobileMenu);

  // ── Language switcher ──
  const langMenu = document.getElementById('lang-switcher-menu');
  const langTrigger = document.getElementById('lang-switcher-trigger');
  const langCode = document.getElementById('lang-code');
  const mobileLangWrap = document.getElementById('lang-switcher-mobile');

  function renderLangSwitcher(active: string) {
    // Update code label
    if (langCode) langCode.textContent = active.toUpperCase();

    // Desktop dropdown
    if (langMenu) {
      langMenu.replaceChildren();
      for (const lang of LANGUAGES) {
        const isActive = lang.code === active;
        const item = document.createElement('button');
        item.type = 'button';
        item.role = 'menuitem';
        item.className = 'w-full flex items-center justify-between gap-3 px-3.5 py-1.5 text-xs text-left hover:bg-sc-surface/80 transition-colors ' + (isActive ? 'text-sc-accent font-semibold' : 'text-sc-text-faint');
        const label = document.createElement('span');
        label.textContent = lang.native;
        item.appendChild(label);
        if (isActive) {
          const check = document.createElement('span');
          check.textContent = '✓';
          check.className = 'text-sc-accent';
          item.appendChild(check);
        }
        item.addEventListener('click', () => {
          setLang(lang.code);
          renderLangSwitcher(lang.code);
          langMenu.classList.add('hidden');
          if (langTrigger) langTrigger.setAttribute('aria-expanded', 'false');
        });
        langMenu.appendChild(item);
      }
    }

    // Mobile chips
    if (mobileLangWrap) {
      mobileLangWrap.replaceChildren();
      for (const lang of LANGUAGES) {
        const isActive = lang.code === active;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = lang.native;
        btn.className = 'px-2.5 py-1 text-xs rounded-full border transition-colors ' + (isActive ? 'bg-sc-accent text-sc-on-accent border-sc-accent font-semibold' : 'bg-sc-surface text-sc-text-soft border-sc-line/20 hover:border-sc-accent');
        btn.addEventListener('click', () => {
          setLang(lang.code);
          renderLangSwitcher(lang.code);
        });
        mobileLangWrap.appendChild(btn);
      }
    }
  }

  // Wire up dropdown toggle
  langTrigger?.addEventListener('click', () => {
    const isHidden = langMenu?.classList.toggle('hidden');
    langTrigger.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    const inside = (e.target as Element).closest?.('#lang-switcher');
    if (!inside && langMenu && !langMenu.classList.contains('hidden')) {
      langMenu.classList.add('hidden');
      if (langTrigger) langTrigger.setAttribute('aria-expanded', 'false');
    }
  });

  // Initialize
  const current = getLang();
  renderLangSwitcher(current);
  applyStaticTranslations(current);
</script>

<style is:global>
  .nav-current:not(.nav-soundlab):not(.nav-musiclab)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.45rem;
    height: 2px;
    border-radius: 999px;
    background: rgb(var(--sc-accent));
  }

  @media (max-width: 767px) {
    .nav-current:not(.nav-soundlab):not(.nav-musiclab)::after {
      left: -0.5rem;
      right: auto;
      bottom: 50%;
      width: 3px;
      height: 1.1rem;
      transform: translateY(50%);
    }
  }

  .nav-soundlab-text {
    display: inline;
    background-image: linear-gradient(
      120deg,
      #ffb7c5 0%,
      #8e7cf3 18%,
      #66d2ff 36%,
      #3be0b0 52%,
      #ffe680 70%,
      #ff6b9d 88%,
      #ffb7c5 100%
    );
    background-size: 220% 100%;
    background-position: 0 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: nav-soundlab-flow 5.6s linear infinite;
    filter: drop-shadow(0 0 14px rgba(142, 124, 243, 0.52))
      drop-shadow(0 0 3px rgba(102, 210, 255, 0.4));
  }

  .nav-soundlab::after {
    content: '';
    position: absolute;
    left: -2%;
    right: -2%;
    top: calc(100% + 0.25rem);
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 183, 197, 0.7) 14%,
      rgba(142, 124, 243, 0.9) 30%,
      rgba(102, 210, 255, 0.9) 48%,
      rgba(59, 224, 176, 0.75) 64%,
      rgba(255, 230, 128, 0.6) 82%,
      transparent 100%
    );
    background-size: 220% 100%;
    opacity: 0.95;
    animation: nav-soundlab-flow 5.6s linear infinite;
    pointer-events: none;
  }

  /* Music Lab navbar - musical glow (cyan/blue/violet) */
  .nav-musiclab-text {
    display: inline;
    background-image: linear-gradient(
      120deg,
      #66d2ff 0%,
      #8e7cf3 30%,
      #a66bff 60%,
      #66d2ff 100%
    );
    background-size: 220% 100%;
    background-position: 0 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: nav-musiclab-glow 4s ease-in-out infinite;
    filter: drop-shadow(0 0 10px rgba(102, 210, 255, 0.4))
      drop-shadow(0 0 2px rgba(166, 106, 255, 0.3));
  }

  .nav-musiclab-glow {
    position: absolute;
    left: -2%;
    right: -2%;
    top: calc(100% + 0.25rem);
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(102, 210, 255, 0.7) 25%,
      rgba(136, 128, 229, 0.8) 50%,
      rgba(166, 106, 255, 0.6) 75%,
      transparent 100%
    );
    background-size: 220% 100%;
    opacity: 0.9;
    animation: nav-musiclab-glow 4s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes nav-soundlab-flow {
    to { background-position: 220% 0; }
  }

  /* Studio nav link — a slow, soft white breath.
     The glow is white only (unlike the coloured SoundLab / Music Lab glows).
     Deliberately gentle: a long 3.2s cycle and a small dim->bright delta, so it
     reads as a glow rather than a blink or a strobe. The text colour itself is
     left alone so the link stays legible in the light theme, where a white glow
     is subtle by nature. */
  .nav-studio-text {
    display: inline-block;
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.22);
    animation: nav-studio-glow 3.2s ease-in-out infinite;
  }

  @keyframes nav-studio-glow {
    0%, 100% { text-shadow: 0 0 5px rgba(255, 255, 255, 0.22); }
    50%      { text-shadow: 0 0 14px rgba(255, 255, 255, 0.5), 0 0 26px rgba(255, 255, 255, 0.16); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-studio-text { animation: none; }
  }

  @keyframes nav-musiclab-glow {
    0%, 100% { background-position: 0 0; filter: drop-shadow(0 0 8px rgba(102, 210, 255, 0.3)); }
    50% { background-position: 220% 0; filter: drop-shadow(0 0 14px rgba(102, 210, 255, 0.6)) drop-shadow(0 0 4px rgba(166, 106, 255, 0.4)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-soundlab-text, .nav-soundlab::after, .nav-musiclab-text, .nav-musiclab-glow { animation: none; }
  }
</style>