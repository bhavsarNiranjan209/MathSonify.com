---
interface Props {
  title: string;
  description?: string;
  /**
   * Set while a feature is unreleased. Emits `noindex, nofollow` so search
   * engines do not index a "being built" page as a launched product.
   * Defaults to false, so public pages stay indexable.
   */
  noindex?: boolean;
}

import '../styles/global.css';

const {
  title,
  description = "Turn Math Into Music - Type an equation, watch it come alive, and hear what mathematics sounds like.",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <!-- `viewport-fit=cover` is what makes env(safe-area-inset-*) report real
         values on notched iPhones; without it every inset is 0 and bottom
         controls sit under the home indicator. See .sc-safe-* in global.css. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpeg" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- SEO -->
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;700&family=Playfair+Display:ital,wght@0,700;1,700&family=Instrument+Serif:ital,wght@0,400;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Apply saved theme before first paint to avoid flashing the wrong mode -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('mathsonify-theme');
          if (saved === 'digital') saved = 'light';
          if (saved === 'mono') saved = 'dark';
          document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : 'dark';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>

    <!-- Apply saved language before first paint -->
    <script is:inline>
      (function () {
        try {
          var lang = localStorage.getItem('mathsonify-lang');
          // Legacy stored values: plain 'en' is now English (US), and
          // removed 'ta' falls back to English (US).
          if (lang === 'en' || lang === 'ta') lang = 'en-US';
          if (lang) {
            document.documentElement.lang = lang;
            document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
          }
        } catch (e) { /* ignore */ }
      })();
    </script>

    <!-- Preloader keyframes (self-contained, no external deps) -->
    <style>
      @keyframes sc-load-wordmark { to { opacity:1; transform:translateY(0); } }
      @keyframes sc-load-domain { to { opacity:1; transform:translateY(0); } }
      @keyframes sc-load-pulse { 0%,100%{opacity:.45} 50%{opacity:1} }
      @keyframes sc-load-bar { 0%,100%{transform:scaleY(0.22)} 50%{transform:scaleY(1)} }
      @keyframes sc-load-travel { 0%{transform:translateX(-100%)} 100%{transform:translateX(100%)} }
      @keyframes sc-load-glow { 0%,100%{opacity:0.3} 50%{opacity:0.9} }
      @keyframes sc-load-dot { 0%,100%{opacity:0.25;transform:scale(0.7)} 50%{opacity:1;transform:scale(1)} }
    </style>
  </head>
  <body>
    <!-- ΓöÇΓöÇ Sound-flowing preloader ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ -->
    <div
      id="sc-preloader"
      aria-hidden="true"
      style="position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgb(var(--sc-bg));transition:opacity .45s ease,transform .45s ease;overflow:hidden"
    >
      <!-- Ambient glow behind the wave ΓÇö pulses like a bass note -->
      <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:520px;height:220px;background:radial-gradient(ellipse at center, rgb(var(--sc-accent) / 0.08) 0%, transparent 70%);border-radius:50%;pointer-events:none;animation:sc-load-glow 2s ease-in-out infinite"></div>

      <!-- MathSonify.com ΓÇö big & bold -->
      <div style="display:flex;align-items:baseline;gap:0;opacity:0;transform:translateY(12px);animation:sc-load-wordmark .7s .1s cubic-bezier(0.22,1,0.36,1) forwards">
        <span style="font-family:'Space Grotesk',sans-serif;font-size:2rem;font-weight:700;color:rgb(var(--sc-text));letter-spacing:-0.03em;line-height:1">MathSonify</span>
        <span style="font-family:'Space Grotesk',sans-serif;font-size:1rem;font-weight:500;color:rgb(var(--sc-accent));letter-spacing:0.02em;margin-left:2px;opacity:0;transform:translateY(4px);animation:sc-load-domain .5s .55s cubic-bezier(0.22,1,0.36,1) forwards">.com</span>
      </div>
      <!-- Subtitle -->
      <div style="margin-top:6px;font-family:'JetBrains Mono',monospace;font-size:9px;color:rgb(var(--sc-text-faint));letter-spacing:0.18em;text-transform:uppercase;opacity:0;transform:translateY(4px);animation:sc-load-domain .5s .65s cubic-bezier(0.22,1,0.36,1) forwards">
        where math becomes music
      </div>

      <!-- Flowing waveform bars ΓÇö music is travelling through them -->
      <div
        id="sc-wave"
        style="position:relative;display:flex;align-items:center;gap:3px;margin-top:1.75rem;height:52px;overflow:hidden;padding:0 4px"
        aria-hidden="true"
      >
        <!-- shimmer that sweeps leftΓåÆright across the bars like a playhead -->
        <div id="sc-wave-shimmer" style="position:absolute;inset:0;background:linear-gradient(90deg,transparent 0%,rgb(var(--sc-accent) / 0.18) 50%,transparent 100%);transform:translateX(-100%);animation:sc-load-travel 2s 0.8s ease-in-out infinite;pointer-events:none;z-index:1"></div>
        <!-- bars injected by inline script below -->
      </div>

      <!-- Bouncing dots ΓÇö like a beat indicator -->
      <div id="sc-dots" style="display:flex;align-items:center;gap:5px;margin-top:1.25rem" aria-hidden="true">
        <!-- dots injected by inline script below -->
      </div>

      <!-- Loading text -->
      <div style="margin-top:10px;font-family:'JetBrains Mono',monospace;font-size:10px;color:rgb(var(--sc-text-faint));letter-spacing:0.14em;text-transform:uppercase;animation:sc-load-pulse 1.4s ease-in-out infinite">
        loading your soundΓÇª
      </div>
    </div>

    <!-- Failsafe panel: shown ONLY if the island never mounts. Static markup,
         no framework — it has to work when React has already failed. -->
    <div
      id="sc-startup-error"
      role="alert"
      style="position:fixed;inset:0;z-index:9998;display:none;align-items:center;justify-content:center;padding:24px;background:rgb(var(--sc-bg))"
    >
      <div style="max-width:34rem;border:1px solid rgb(var(--sc-line) / .3);border-top:2px solid rgb(var(--sc-live) / .6);border-radius:12px;padding:24px;background:rgb(var(--sc-surface))">
        <p style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:rgb(var(--sc-text-faint))">
          MathSonify · could not start
        </p>
        <h1 style="margin-top:12px;font-family:'Space Grotesk',sans-serif;font-size:1.35rem;font-weight:600;color:rgb(var(--sc-text))">
          This page did not finish loading.
        </h1>
        <p style="margin-top:10px;font-size:0.9rem;line-height:1.6;color:rgb(var(--sc-text-soft))">
          This is a bug on our side, not something you did. Reloading usually clears it.
        </p>
        <pre id="sc-startup-diag" style="margin-top:14px;max-height:10rem;overflow:auto;white-space:pre-wrap;word-break:break-word;font-family:'JetBrains Mono',monospace;font-size:11px;line-height:1.6;color:rgb(var(--sc-text-soft));background:rgb(var(--sc-sunken));border:1px solid rgb(var(--sc-line) / .2);border-radius:8px;padding:10px"></pre>
        <div style="margin-top:18px;display:flex;flex-wrap:wrap;gap:10px">
          <button id="sc-startup-reload" type="button" style="min-height:44px;padding:0 20px;border-radius:8px;border:1px solid rgb(var(--sc-accent));background:rgb(var(--sc-accent));color:rgb(var(--sc-on-accent));font-size:14px;cursor:pointer">
            Reload
          </button>
          <a href="/" style="display:inline-flex;align-items:center;min-height:44px;padding:0 20px;border-radius:8px;border:1px solid rgb(var(--sc-line) / .3);color:rgb(var(--sc-text-soft));font-size:14px;text-decoration:none">
            Back to MathSonify
          </a>
        </div>
      </div>
    </div>

    <!-- Scroll progress bar -->
    <div id="scroll-progress" aria-hidden="true"></div>

    <slot />

    <!-- Scroll progress + button ripple (no reveal observer ΓÇö pages render immediately) -->
    <script is:inline>
      (function () {
        var bar = document.getElementById('scroll-progress');
        if (bar) {
          window.addEventListener('scroll', function() {
            var scrollTop = window.scrollY || document.documentElement.scrollTop;
            var docHeight = document.documentElement.scrollHeight - window.innerHeight;
            var pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
            bar.style.width = pct + '%';
          }, { passive: true });
        }
        document.querySelectorAll('.btn-primary').forEach(function(btn) {
          btn.addEventListener('mousedown', function(e) {
            var rect = btn.getBoundingClientRect();
            var x = ((e.clientX - rect.left) / rect.width) * 100;
            var y = ((e.clientY - rect.top) / rect.height) * 100;
            btn.style.setProperty('--ripple-x', x + '%');
            btn.style.setProperty('--ripple-y', y + '%');
          });
        });
      })();
    </script>

    <!-- Preloader logic ΓÇö runs immediately, zero deps -->
    <script is:inline>
      (function () {
        // ── Startup: dismiss the preloader from SEVERAL independent paths ──
        //
        // This node is `position:fixed; inset:0; z-index:9999` over an opaque
        // background, so if it is never removed it hides the page completely —
        // the visitor sees a blank studio that is in fact rendered underneath.
        // The previous version had exactly ONE removal path and it began with
        // `if (!wave) return;`, an early return that skipped the only
        // setTimeout capable of removing the overlay. Everything below is armed
        // before any decorative code can run, and the 8s failsafe is registered
        // synchronously so no throw and no early return can preempt it.
        var PRELOADER_ID = 'sc-preloader';
        var ERROR_ID = 'sc-startup-error';
        var MOUNT_TIMEOUT_MS = 8000;
        var startedAt = Date.now();
        var reducedMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        var state = {
          dismissed: false,
          mounted: false,
          islandExpected: false,
          emptyIsland: false,
          errorShown: false,
          cosmeticArmed: false,
        };

        function dismiss(reason) {
          if (state.dismissed) return;
          state.dismissed = true;
          state.dismissReason = reason;
          var el = document.getElementById(PRELOADER_ID);
          if (!el) return;
          el.style.opacity = '0';
          el.style.transform = 'scale(1.02)';
          setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 500);
        }

        function showStartupError(reason) {
          if (state.errorShown) return;
          state.errorShown = true;
          var panel = document.getElementById(ERROR_ID);
          if (!panel) return;
          panel.style.display = 'flex';
          var diag = document.getElementById('sc-startup-diag');
          if (diag) {
            diag.textContent = [
              'reason: ' + reason,
              'astro-island present: ' + state.islandExpected,
              'island still empty: ' + state.emptyIsland,
              'island mounted: ' + state.mounted,
              'readyState: ' + document.readyState,
              'elapsed: ' + (Date.now() - startedAt) + 'ms',
              'url: ' + location.href,
            ].join('\n');
          }
          try {
            console.warn('[MathSonify] page startup failed: ' + reason, {
              islandExpected: state.islandExpected,
              islandMounted: state.mounted,
              readyState: document.readyState,
              elapsedMs: Date.now() - startedAt,
            });
          } catch (e) { /* logging is best-effort; the panel is the contract */ }
        }

        var reloadBtn = document.getElementById('sc-startup-reload');
        if (reloadBtn) {
          reloadBtn.addEventListener('click', function () { location.reload(); });
        }

        // An island with NO children is either a `client:only` island — Astro
        // ships its element but none of its markup, so the page really is empty
        // until React paints — OR an island that hydrated successfully but
        // legitimately renders nothing while closed (e.g. the Scientist modal
        // on /scientists, which only paints once a card is clicked). Children
        // alone cannot tell those apart, so hydration has to count too: after
        // a successful hydrate Astro removes the island's `ssr` attribute and
        // dispatches a non-bubbling `astro:hydrate` event on the element.
        function islandReady(el) {
          return (
            el.children.length > 0 ||
            el.dataset.scHydrated === '1' ||
            !el.hasAttribute('ssr')
          );
        }
        function anyEmptyIsland() {
          var list = document.querySelectorAll('astro-island');
          for (var i = 0; i < list.length; i++) if (!islandReady(list[i])) return true;
          return false;
        }
        function allIslandsMounted() {
          var list = document.querySelectorAll('astro-island');
          for (var i = 0; i < list.length; i++) if (!islandReady(list[i])) return false;
          return list.length > 0;
        }
        // PATH 1 — the island itself reporting for duty. Observed AND polled,
        // so neither mechanism has to be individually reliable. `astro:hydrate`
        // listeners are attached too: an island that mounts to zero children
        // (a closed modal) produces no DOM mutation at all, so the observer
        // and the poll would never see it — the event is the only signal.
        function watchIslands() {
          var list = document.querySelectorAll('astro-island');
          for (var i = 0; i < list.length; i++) {
            (function (el) {
              el.addEventListener('astro:hydrate', function () {
                el.dataset.scHydrated = '1';
                if (allIslandsMounted()) { state.mounted = true; dismiss('island-mounted'); }
              });
            })(list[i]);
          }
          if (allIslandsMounted()) { state.mounted = true; dismiss('island-mounted'); return; }
          try {
            var obs = new MutationObserver(function () {
              if (allIslandsMounted()) { state.mounted = true; obs.disconnect(); dismiss('island-mounted'); }
            });
            obs.observe(document.documentElement, { childList: true, subtree: true });
          } catch (e) { /* the poll below still runs */ }
          var poll = setInterval(function () {
            if (allIslandsMounted()) { state.mounted = true; clearInterval(poll); dismiss('island-mounted'); }
          }, 400);
        }

        // PATH 3 — pages whose markup is already on screen keep the branded
        // window they had before: fonts, a short floor, and a hard cap.
        function armCosmetic() {
          if (state.cosmeticArmed) return;
          state.cosmeticArmed = true;
          if (reducedMotion) { setTimeout(function () { dismiss('reduced-motion'); }, 300); return; }
          var t0 = Date.now();
          var fontsReady = document.fonts ? document.fonts.ready : Promise.resolve();
          fontsReady.then(function () {
            setTimeout(function () { dismiss('fonts-ready'); }, Math.max(0, 900 - (Date.now() - t0)));
          });
          setTimeout(function () { dismiss('cosmetic-cap'); }, 2800);
        }

        var armed = false;
        function armPaths() {
          if (armed) return;
          armed = true;
          state.islandExpected = !!document.querySelector('astro-island');
          state.emptyIsland = anyEmptyIsland();
          if (state.emptyIsland) watchIslands();
          else armCosmetic();
        }

        // PATH 4 — ABSOLUTE failsafe, registered before anything decorative can
        // run. It removes the overlay unconditionally, and escalates to the
        // visible error panel when the page really did fail to start.
        setTimeout(function () {
          dismiss('startup-timeout-' + MOUNT_TIMEOUT_MS + 'ms');
          if (state.emptyIsland && !state.mounted) {
            showStartupError('island did not mount within ' + MOUNT_TIMEOUT_MS + 'ms');
          }
        }, MOUNT_TIMEOUT_MS);

        // PATH 2 — DOMContentLoaded re-arms everything, so a script that ran
        // while the document was still parsing (or whose first arm failed) is
        // never the single point of failure.
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () { armPaths(); });
        }
        armPaths();

        // The bars and dots are decoration, so they get their own function: a
        // failure or an early return inside them can no longer skip dismissal,
        // which is exactly what the old top-level `if (!wave) return` did.
        function buildLoaderArt() { try {
        var wave = document.getElementById('sc-wave');
        var dotsEl = document.getElementById('sc-dots');
        if (!wave) return;

        // ΓöÇΓöÇ Waveform bars: 32 bars, sine envelope + staggered wave animation
        //    so the crest travels leftΓåÆright like a real sound wave
        var BAR_COUNT = 32;
        for (var i = 0; i < BAR_COUNT; i++) {
          var bar = document.createElement('span');
          // Envelope: taller in the centre, shorter at the edges (like a speaker cone)
          var env = Math.sin(Math.PI * (i + 0.5) / BAR_COUNT);
          var baseH = 6 + 30 * env;
          // Each bar's animation is offset so the wave crest travels across
          var delay = (i * 0.038).toFixed(3);
          bar.style.cssText =
            'display:block;width:3px;min-width:3px;border-radius:9999px;' +
            'background:rgb(var(--sc-accent));' +
            'height:' + baseH.toFixed(1) + 'px;transform-origin:center;opacity:0;' +
            'animation:sc-load-bar 1.1s ' + delay + 's ease-in-out infinite;';
          // Fade bars in one by one on first paint
          bar.style.animationDelay = delay + 's';
          (function(b, idx) {
            setTimeout(function(){ b.style.opacity = '1'; }, idx * 22 + 200);
          })(bar, i);
          wave.appendChild(bar);
        }

        // ΓöÇΓöÇ Bouncing dots (beat dots)
        if (dotsEl) {
          for (var d = 0; d < 3; d++) {
            var dot = document.createElement('span');
            dot.style.cssText =
              'display:block;width:6px;height:6px;border-radius:50%;background:rgb(var(--sc-accent));' +
              'animation:sc-load-dot 1s ' + (d * 0.16).toFixed(3) + 's ease-in-out infinite';
            dotsEl.appendChild(dot);
          }
        }

        // Reduced motion: show static bars, dismiss quickly
        var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) {
          var bars = wave.querySelectorAll('span');
          for (var j = 0; j < bars.length; j++) {
            bars[j].style.animation = 'none';
            bars[j].style.opacity = '0.55';
          }
          var shimmer = document.getElementById('sc-wave-shimmer');
          if (shimmer) shimmer.style.display = 'none';
          if (dotsEl) {
            var dots = dotsEl.querySelectorAll('span');
            for (var k = 0; k < dots.length; k++) {
              dots[k].style.animation = 'none';
              dots[k].style.opacity = '0.5';
            }
          }
        }

        } catch (e) {
          // Decorative only — a throw here must never strand the overlay.
        }
        }

        // Dismissal was armed above; all that is left is the decoration.
        buildLoaderArt();
      })();
    </script>
  </body>
</html>
