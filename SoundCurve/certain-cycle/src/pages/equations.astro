---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { PRESET_CATEGORIES, sortPresets } from '../data/presets';
---

<BaseLayout title="Equations Reference - MathSonify" description="Mathematical and acoustic catalog of functions supported in MathSonify.">
  <Navigation />

  <main class="min-h-screen pt-20 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 border border-sc-accent/40 bg-sc-accent/15 rounded-full font-mono text-xs text-sc-accent mb-4" data-i18n="equations.tag">
        mathematical catalog
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-sc-text tracking-tight mb-4" data-i18n="equations.title">
        Equation acoustic reference
      </h1>
      <p class="text-sm sm:text-base text-sc-text-soft leading-relaxed" data-i18n="equations.subtitle">
        A complete reference of all mathematical functions supported in MathSonify — browse by category or search by name.
      </p>
    </div>

    <!-- Search bar -->
    <div class="max-w-md mx-auto mb-6">
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sc-text-faint">🔍</span>
        <input
          type="text"
          id="equation-search"
          placeholder="Search equations..."
          class="w-full pl-10 pr-4 py-3 rounded-lg bg-sc-surface border border-sc-line/20 text-sm text-sc-text placeholder:text-sc-text-faint focus:outline-none focus:ring-2 focus:ring-sc-accent/50 focus:border-sc-accent transition-colors min-h-[44px]"
        />
      </div>
    </div>

    <!-- Liquid-ripple filter for the "Funny Questions" chip.
         feTurbulence generates the wobble, feDisplacementMap bends the border
         along it. The two <animate> elements are driven by JS via
         beginElement() so the ripple can be replayed on every click, and they
         `fill="freeze"` on a small non-zero scale so the outline rests on a
         subtly wavy state instead of snapping back to a straight line.
         Kept in the render tree (0x0, clipped) rather than display:none —
         display:none can break filter references in some engines. -->
    <div aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none">
      <svg width="0" height="0" focusable="false">
        <filter id="sc-ripple" x="-30%" y="-120%" width="160%" height="340%" color-interpolation-filters="sRGB">
          <feTurbulence
            id="sc-ripple-noise"
            type="fractalNoise"
            baseFrequency="0.018 0.055"
            numOctaves="2"
            seed="11"
            result="noise"
          >
            <animate
              id="sc-ripple-noise-anim"
              attributeName="baseFrequency"
              values="0.018 0.055;0.03 0.085;0.018 0.055"
              dur="2s"
              fill="freeze"
            />
          </feTurbulence>
          <feDisplacementMap
            id="sc-ripple-map"
            in="SourceGraphic"
            in2="noise"
            scale="2"
            xChannelSelector="R"
            yChannelSelector="G"
          >
            <!-- Plays out to a strong wobble, then settles at scale 2: visibly
                 liquid, but not a straight border. One-shot, not looping. -->
            <animate
              id="sc-ripple-map-anim"
              attributeName="scale"
              values="2;10;2;6;2"
              keyTimes="0;0.22;0.5;0.75;1"
              dur="2s"
              calcMode="spline"
              keySplines="0.34 0 0.2 1;0.34 0 0.2 1;0.34 0 0.2 1;0.34 0 0.2 1"
              fill="freeze"
            />
          </feDisplacementMap>
        </filter>
      </svg>
    </div>

    <!-- Category filter bar -->
    <div class="flex items-center justify-center gap-2 flex-wrap mb-10">
      {PRESET_CATEGORIES.map((cat) => (
        <button
          class={`category-filter-btn px-4 py-1.5 rounded-full text-xs font-medium bg-sc-surface hover:bg-sc-accent/15 text-sc-text-soft hover:text-sc-text border border-sc-line/20 hover:border-sc-accent transition-colors${cat.id === 'rare' ? ' chip--wavy' : ''}`}
          data-category={cat.id}
        >
          {/* Only the Funny Questions chip carries the ripple outline. The
              filter is applied to this layer alone, so the chip's own label
              text is never displaced. */}
          {cat.id === 'rare' && <span class="chip-ripple" aria-hidden="true" />}
          <span class="chip-label">{cat.name}</span>
        </button>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results-eq" class="hidden text-center py-12">
      <p class="text-sc-text-soft text-sm">No equations found matching your search.</p>
    </div>

    <!-- Equation grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="equations-grid">
      {sortPresets().map((preset) => (
        <div
          class={`equation-card panel p-5 flex flex-col justify-between hover:border-sc-accent/50 transition-colors${preset.accentColor ? ' equation-card--glow' : ''}`}
          data-category={preset.category}
          // The accent arrives as a custom property rather than a ready-made
          // `box-shadow`, because `box-shadow` cannot be animated — the glow
          // has to be composed in CSS (see `.equation-card--glow` in
          // global.css) for it to breathe. Cards without an accent get neither
          // the class nor the property, so they are byte-for-byte unchanged.
          style={preset.accentColor ? `--card-accent: ${preset.accentColor};` : undefined}
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-sc-accent/15 text-sc-accent border border-sc-accent/40">
                {preset.category}
              </span>
              <span class="text-xs text-sc-text-faint font-mono">
                {preset.recommendedSettings.instrument} / {preset.recommendedSettings.sonificationMode}
              </span>
            </div>
            <h3 class="text-base font-semibold text-sc-text mb-2">{preset.name}</h3>
            <div class="code-mat text-xs px-3 py-2 mb-3 overflow-x-auto select-none [-webkit-touch-callout:none]">
              {preset.equation}
            </div>
            <p class="text-xs text-sc-text-soft leading-relaxed mb-3">
              {preset.description}
            </p>
            <div class="p-2.5 rounded-md bg-sc-surface border border-sc-line/15 text-xs text-sc-text-soft mb-4">
              <span class="text-sc-accent font-medium">Sonic profile:</span> {preset.soundDescription}
            </div>
          </div>

          <div class="pt-3 border-t border-sc-line/15 flex items-center justify-between">
            <span class="text-[11px] font-mono text-sc-text-faint">
              Domain: [{preset.recommendedSettings.minX}, {preset.recommendedSettings.maxX}]
            </span>
            <a
              href={`/studio?eq=${encodeURIComponent(preset.equation)}&inst=${preset.recommendedSettings.instrument}&mode=${preset.recommendedSettings.sonificationMode}&dur=${preset.recommendedSettings.duration}&minX=${preset.recommendedSettings.minX}&maxX=${preset.recommendedSettings.maxX}`}
              class="px-4 py-1.5 rounded-md btn-primary text-xs"
            >
              Open in Studio
            </a>
          </div>
        </div>
      ))}
    </div>

    <script is:inline>
      (function() {
        var searchInput = document.getElementById('equation-search');
        var noResults = document.getElementById('no-results-eq');
        var cards = document.querySelectorAll('.equation-card');
        var filterBtns = document.querySelectorAll('.category-filter-btn');

        // Equations are for clicking, not copying: block copy on the
        // formula text so visitors open the equation in the Studio and
        // listen instead of taking the text away.
        cards.forEach(function (card) {
          card.querySelectorAll('.code-mat').forEach(function (el) {
            el.addEventListener('copy', function (e) { e.preventDefault(); });
          });
        });

        if (!searchInput || cards.length === 0) return;

        var ACTIVE = ['bg-sc-accent', 'text-sc-on-accent', 'border-sc-accent'];
        var IDLE = ['bg-sc-surface', 'text-sc-text-soft', 'border-sc-line/20', 'hover:bg-sc-accent/15', 'hover:text-sc-text', 'hover:border-sc-accent'];

        function setActive(btn) {
          filterBtns.forEach(function(b) {
            b.classList.remove.apply(b.classList, ACTIVE);
            b.classList.add.apply(b.classList, IDLE);
          });
          btn.classList.remove.apply(btn.classList, IDLE);
          btn.classList.add.apply(btn.classList, ACTIVE);
        }

        if (filterBtns[0]) setActive(filterBtns[0]);

        var activeCategory = 'all';

        function applyFilters() {
          var term = searchInput.value.trim().toLowerCase();
          var visible = 0;
          cards.forEach(function(card) {
            var cardCat = card.getAttribute('data-category');
            var text = (card.textContent || '').toLowerCase();
            var catMatch = activeCategory === 'all' || cardCat === activeCategory;
            var searchMatch = !term || text.includes(term);
            var show = catMatch && searchMatch;
            card.style.display = show ? '' : 'none';
            if (show) visible++;
          });
          if (noResults) noResults.classList.toggle('hidden', visible > 0);
        }

        /* Replay the "Funny Questions" ripple.
           The filter's two <animate> elements end with fill="freeze" on a
           slightly wavy scale, so the outline keeps a subtle organic edge at
           rest. beginElement() restarts them from 0 for the 2s play, which is
           what makes repeat clicks ripple again rather than doing nothing. */
        function playRipple() {
          ['sc-ripple-map-anim', 'sc-ripple-noise-anim'].forEach(function(id) {
            var node = document.getElementById(id);
            if (!node || typeof node.beginElement !== 'function') return;
            try { node.beginElement(); } catch (e) { /* SMIL unsupported */ }
          });
        }

        // Only replay for the chip that actually has the ripple.
        filterBtns.forEach(function(btn) {
          btn.addEventListener('click', function() {
            activeCategory = btn.getAttribute('data-category');
            setActive(btn);
            applyFilters();
            if (activeCategory === 'rare') playRipple();
          });
        });

        // If this chip is already the selected filter on load, ripple once.
        if (activeCategory === 'rare') playRipple();

        searchInput.addEventListener('input', applyFilters);
      })();
    </script>
  </main>

  <Footer />
</BaseLayout>
