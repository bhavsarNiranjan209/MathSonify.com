---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
// The curated-sonifications grid, the feature grid and the SoundLab teaser
// were removed from this page: the homepage is now Hero -> quote/CTA -> Footer.
// `PRESETS` and `FEATURE_FLAGS` were only imported for those sections.
---

<BaseLayout title="MathSonify - Turn Math Into Music">
  <Navigation />

  <main>
    <Hero />

    <!-- Callout -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto text-center">
      <div class="panel p-8 sm:p-12 border-t-2 border-sc-accent/50">
        <blockquote class="font-serif text-xl sm:text-2xl md:text-3xl font-medium text-sc-text mb-6 leading-snug" data-i18n="home.calloutQuote">
          "Wait... you can actually hear the geometry of mathematics?"
        </blockquote>
        <p class="text-sm text-sc-text-soft max-w-xl mx-auto mb-8" data-i18n="home.calloutDesc">
          MathSonify turns abstract equations into an intuitive sensory experience for students, musicians, educators, and creative coders.
        </p>
        <a href="/studio" class="btn-primary inline-flex items-center px-8 py-3.5 text-base" data-i18n="home.calloutCta">
          Start creating in the Studio
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
