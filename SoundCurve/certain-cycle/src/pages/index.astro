---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import TryItCard from '../components/TryItCard';
// The curated-sonifications grid, the feature grid and the SoundLab teaser
// were removed from this page: the homepage is now Hero -> quote/CTA -> Footer.
// `PRESETS` and `FEATURE_FLAGS` were only imported for those sections.
---

<BaseLayout title="MathSonify - Turn Math Into Music">
  <Navigation />

  <main>
    <Hero />

    <!-- Try-it card — the working y = sin(x) player beside "Try it
      yourself." and an Open Studio button. Replaces the old globe banner. -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
      <TryItCard client:load equation="sin(x)" duration={5} />
    </section>
  </main>

  <Footer />
</BaseLayout>
