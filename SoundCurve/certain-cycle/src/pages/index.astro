---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
// The curated-sonifications grid, the feature grid and the SoundLab teaser
// were removed from this page: the homepage is now Hero -> quote/CTA -> Footer.
// `PRESETS` and `FEATURE_FLAGS` were only imported for those sections.
---

<BaseLayout title="MathSonify - Turn Math Into Music">
  <Navigation />

  <main>
    <Hero />

    <!-- Banner — AI-generated science + art, links to the Studio -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
      <a
        href="/studio"
        class="block overflow-hidden rounded-lg border border-sc-line/15 transition hover:border-sc-accent/50 hover:opacity-95 focus-visible:ring-2 focus-visible:ring-sc-accent/60"
      >
        <img
          src="/images/home-banner-science-art.png"
          alt="Where logic creates music — a glowing wireframe sphere showing x squared plus y squared equals r squared, over gold wave curves. Enter the Studio."
          width="1403"
          height="293"
          loading="lazy"
          class="block h-auto w-full"
        />
      </a>
    </section>
  </main>

  <Footer />
</BaseLayout>
