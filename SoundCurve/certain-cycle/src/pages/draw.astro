---
/**
 * Draw — sketch-to-music.
 *
 * Release-controlled by `FEATURE_FLAGS.draw` (src/config/featureFlags.ts).
 *
 * While the flag is false this route renders the lightweight "being built"
 * state, and the real FreehandDraw app is never imported, so its React bundle,
 * audio engine and animation loop are not shipped on this page at all.
 *
 * The import is dynamic and conditional, so flipping the flag to `true` is the
 * only change needed to release it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import FeatureBuildingState from '../components/FeatureBuildingState.astro';
import { FEATURE_FLAGS } from '../config/featureFlags';

const enabled = FEATURE_FLAGS.draw;
const description = 'Draw freely while an always-on scan line turns every curve into a looping pentatonic performance.';
// Statically referenced so Astro can hydrate it when released; tree-shaken out
// of the emitted page while the feature is disabled.
import FreehandDraw from '../components/FreehandDraw';
---

{
  enabled && FreehandDraw ? (
    <BaseLayout title="Draw & Perform - MathSonify" description={description}>
      <Navigation />
      <FreehandDraw client:only="react" />
      <Footer />
    </BaseLayout>
  ) : (
    <BaseLayout
      title="Draw - Something is being drawn | MathSonify"
      description="A sketch-to-music experience where a drawn curve becomes a mathematical performance."
      noindex
    >
      <Navigation />
      <FeatureBuildingState feature="draw" description={description} />
      <Footer />
    </BaseLayout>
  )
}
