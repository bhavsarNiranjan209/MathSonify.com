---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import FreehandDraw from '../components/FreehandDraw';

---

  <script is:inline>
    try {
      const stored = localStorage.getItem('mathsonify-draw-theme');
      if (stored === 'light' || stored === 'dark') document.documentElement.dataset.drawTheme = stored;
    } catch { /* storage may be blocked */ }
  </script>
<BaseLayout title="Draw & Perform - MathSonify" description="Draw freely on paper while an always-on scan line turns every color into a looping pentatonic performance.">
  <div class="draw-page min-h-screen">
    <Navigation />
    <FreehandDraw client:only="react" />
    <Footer />
  </div>
</BaseLayout>

<style is:global>
  .draw-page {
    --sc-bg: 8 10 12;
    --sc-surface: 16 19 22;
    --sc-sunken: 12 14 17;
    --sc-text: 242 242 240;
    --sc-text-soft: 167 171 176;
    --sc-text-faint: 142 148 154;
    --sc-line: 41 45 50;
    --sc-accent: 232 232 230;
    --sc-on-accent: 8 10 12;
    --sc-live: 74 124 116;
    color-scheme: dark;
  }

  html[data-draw-theme='light'] .draw-page {
    --sc-bg: 245 247 250;
    --sc-surface: 255 255 255;
    --sc-sunken: 232 236 242;
    --sc-text: 24 30 38;
    --sc-text-soft: 65 75 88;
    --sc-text-faint: 91 102 116;
    --sc-line: 197 205 216;
    --sc-accent: 29 78 216;
    --sc-on-accent: 255 255 255;
    --sc-live: 21 128 61;
    color-scheme: light;
  }

  html[data-draw-theme='light'] .draw-page footer {
    background: rgb(var(--sc-bg));
  }

  html[data-draw-theme='light'] .draw-page nav {
    background: rgb(var(--sc-bg));
  }

  html[data-draw-theme='light'] .draw-page .draw-export-error {
    color: rgb(185 28 28);
    border-color: rgb(252 165 165 / 0.55);
    background: rgb(254 226 226 / 0.7);
  }
</style>
