---
/**
 * SoundLab — proprietary multi-track equation compositions.
 *
 * Each composition is a curated system of original equations mapped to
 * instruments (melody stack + harmony + bass + rhythm/drum layer).
 *
 * © 2026 MathSonify — proprietary compositions. All rights reserved.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import CompositionPlayer from '../components/SoundLab/CompositionPlayer';
import CompositionCard from '../components/SoundLab/CompositionCard';
import { COMPOSITIONS, GENRES, COPYRIGHT } from '../data/compositions';

// Resolve hash fragment on the server if present (SSR-safe: window check client-only)
---

<BaseLayout
  title="SoundLab — Proprietary Equation Compositions | MathSonify"
  description="15 original, copyrighted equation compositions by MathSonify — ambient, rock, jazz, EDM, classical and more. Each piece is a system of equations rendered as music. Play and tweak. © MathSonify."
>
  <Navigation />

  <!-- JSON-LD structured data + metadata -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'MusicGroup',
    name: 'SoundLab — MathSonify',
    description: 'Proprietary equation compositions by MathSonify — music rendered from original systems of mathematical equations.',
    copyrightHolder: { '@type': 'Organization', name: 'MathSonify' },
    album: COMPOSITIONS.map((c) => ({
      '@type': 'MusicComposition' as const,
      name: c.title,
      genre: c.genre,
      copyright: c.copyright,
    })),
  })} />

  <main class="soundlab min-h-screen pt-20 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Hero: wordmark + copyright + description -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 border border-sc-accent/40 bg-sc-accent/15 rounded-full font-mono text-xs text-sc-accent mb-4" data-i18n="soundlab.tag">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M15.54 8.46a5 5 0 010 7.07"/><path d="M19.07 4.93a10 10 0 010 14.14"/>
        </svg>
        proprietary compositions
      </div>
      <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-sc-text tracking-tight mb-3" data-i18n="soundlab.title">
        SoundLab
      </h1>
      <p class="text-sm text-sc-text-soft leading-relaxed mb-3" data-i18n="soundlab.subtitle">
        Fifteen original systems of equations, each handcrafted into a full-band composition — melody, harmony, bass, and rhythm playing together. Play, tweak, and hear the math.
      </p>
      <p class="text-[11px] font-mono text-sc-text-faint" data-i18n="soundlab.copyright">
        All compositions and equations © MathSonify — all rights reserved. Playback for listening; equations not licensed for reuse.
      </p>
    </div>

    <!-- Search bar -->
    <div class="max-w-md mx-auto mb-6">
      <div class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sc-text-faint">🔍</span>
        <input
          type="text"
          id="soundlab-search"
          placeholder="Search compositions, genres, titles…"
          class="w-full pl-10 pr-4 py-3 rounded-lg bg-sc-surface border border-sc-line/20 text-sm text-sc-text placeholder:text-sc-text-faint focus:outline-none focus:ring-2 focus:ring-sc-accent/50 focus:border-sc-accent transition-colors min-h-[44px]"
        />
      </div>
    </div>

    <!-- Genre filter chips -->
    <div class="flex items-center justify-center gap-2 flex-wrap mb-10" id="soundlab-filter-bar">
      <button
        class="genre-filter-btn px-4 py-1.5 rounded-full text-xs font-medium bg-sc-accent text-sc-on-accent border border-sc-accent"
        data-genre="all"
      >
        All
      </button>
      {GENRES.map((genre) => (
        <button
          class="genre-filter-btn px-4 py-1.5 rounded-full text-xs font-medium bg-sc-surface hover:bg-sc-accent/15 text-sc-text-soft hover:text-sc-text border border-sc-line/20 hover:border-sc-accent transition-colors"
          data-genre={genre.id}
        >
          {genre.emoji} {genre.label}
        </button>
      ))}
    </div>

    <!-- No results message -->
    <div id="soundlab-no-results" class="hidden text-center py-12">
      <p class="text-sc-text-soft text-sm">No compositions found matching your search.</p>
    </div>

    <!-- Gallery grid: 15 cards, 3 per row on desktop -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-12" id="soundlab-grid">
      {COMPOSITIONS.map((comp) => (
        /* Render each card; interactivity is wired by the player island below + inline script */
        <div
          class="soundlab-card-outer"
          data-genre={comp.genre}
          data-title={comp.title.toLowerCase()}
          data-description={comp.description.toLowerCase()}
          id={`soundlab-card-${comp.id}`}
        >
          <CompositionCard composition={comp} active={false} client:visible />
        </div>
      ))}
    </div>

    <!-- Player island — sticky / mounted below grid -->
    <section class="max-w-3xl mx-auto" id="soundlab-player-wrap">
      <CompositionPlayer client:only="react" />
    </section>

    <!-- Extensibility slot: YT-driven features will mount here without touching the gallery -->
    <section id="soundlab-extensions" class="mt-12" aria-label="SoundLab extensions"></section>

    <section class="music-lab-cta mt-16" aria-labelledby="music-lab-cta-title">
      <div class="music-lab-cta__content">
        <div class="music-lab-cta__topline">
          <span>PREMIUM STUDIO</span>
          <span>NEW</span>
        </div>
        <p class="music-lab-cta__title" id="music-lab-cta-title">MUSIC LAB</p>
        <h2>Compose beyond the equation.</h2>
        <p>Build your own mathematical instruments, shape their sound, arrange notes, and watch every musical decision transform the mathematics underneath.</p>
      </div>
      <div class="music-lab-cta__symbols" aria-hidden="true">
        <span>∫</span><span>Σ</span><span>π</span><span>∞</span><span>Δ</span><span>φ</span><span>λ</span><span>∂</span>
      </div>
      <a class="music-lab-cta-button" href="/music-lab">Enter Music Lab <span aria-hidden="true">→</span></a>
    </section>

    <!-- Meta footer line -->
    <p class="mt-8 text-center text-[10px] font-mono text-sc-text-faint">
      {COPYRIGHT}
    </p>

    <script is:inline>
      (function() {
        var searchInput = document.getElementById('soundlab-search');
        var noResults   = document.getElementById('soundlab-no-results');
        var cards       = document.querySelectorAll('.soundlab-card-outer');
        var filterBtns  = document.querySelectorAll('.genre-filter-btn');
        if (!searchInput || cards.length === 0) return;

        var ACTIVE = ['bg-sc-accent', 'text-sc-on-accent', 'border-sc-accent'];
        var IDLE   = ['bg-sc-surface', 'text-sc-text-soft', 'border-sc-line/20', 'hover:bg-sc-accent/15', 'hover:text-sc-text', 'hover:border-sc-accent'];

        function setActive(btn) {
          filterBtns.forEach(function(b) {
            b.classList.remove.apply(b.classList, ACTIVE);
            b.classList.add.apply(b.classList, IDLE);
          });
          btn.classList.remove.apply(btn.classList, IDLE);
          btn.classList.add.apply(btn.classList, ACTIVE);
        }

        if (filterBtns[0]) setActive(filterBtns[0]);

        var activeGenre = 'all';

        function applyFilters() {
          var term = searchInput.value.trim().toLowerCase();
          var visible = 0;
          cards.forEach(function(card) {
            var cardGenre = card.getAttribute('data-genre');
            var title = card.getAttribute('data-title') || '';
            var desc  = card.getAttribute('data-description') || '';
            var text  = (title + ' ' + desc + ' ' + cardGenre).toLowerCase();
            var genreMatch  = activeGenre === 'all' || cardGenre === activeGenre;
            var searchMatch = !term || text.includes(term);
            var show = genreMatch && searchMatch;
            card.style.display = show ? '' : 'none';
            if (show) visible++;
          });
          if (noResults) noResults.classList.toggle('hidden', visible > 0);
        }

        filterBtns.forEach(function(btn) {
          btn.addEventListener('click', function() {
            activeGenre = btn.getAttribute('data-genre');
            setActive(btn);
            applyFilters();
          });
        });

        searchInput.addEventListener('input', applyFilters);

        // Deep-link: scroll and focus card whose id matches location.hash (client-side)
        var hash = window.location.hash.replace('#','').trim();
        if (hash) {
          var targetCard = document.getElementById('soundlab-card-' + hash);
          if (targetCard) {
            setTimeout(function() {
              targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
              targetCard.style.outline = '2px solid var(--sc-accent, #c9a24b)';
              targetCard.style.outlineOffset = '4px';
              setTimeout(function(){ targetCard.style.outline = ''; }, 2500);
            }, 300);
          }
        }
      })();
    </script>
  </main>

  <Footer />
</BaseLayout>
