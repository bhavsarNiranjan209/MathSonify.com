---
/**
 * SoundLab — proprietary multi-track equation compositions.
 *
 * Each composition is a curated system of original equations mapped to
 * instruments (melody stack + harmony + bass + rhythm layer).
 *
 * Release-controlled by `FEATURE_FLAGS.soundLab`
 * (src/config/featureFlags.ts). While the flag is false the route renders the
 * lightweight "being built" state and the real workspace — including the
 * composition engine, audio graph and the full composition catalogue — is
 * never imported or shipped on this page.
 *
 * © 2026 MathSonify — proprietary compositions. All rights reserved.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import FeatureBuildingState from '../components/FeatureBuildingState.astro';
// Statically referenced so Astro can hydrate it when released. Rollup still
// tree-shakes this out of the emitted page unless the `enabled` branch below
// is taken, so a disabled build ships no SoundLab JavaScript at all.
import SoundLabWorkspace from '../components/SoundLab/SoundLabWorkspace';
import { FEATURE_FLAGS } from '../config/featureFlags';

const enabled = FEATURE_FLAGS.soundLab;
const description =
  'Original multi-track compositions, each one a system of equations rendered through instruments.';

// Loaded only when the feature is actually released. Astro's compiler needs a
// statically analysable component to hydrate, so the app is referenced through
// `client:only` in the branch below; the *data* import stays conditional so the
// composition catalogue and audio engine are not pulled into a disabled build.
const structuredData = enabled
  ? {
      '@context': 'https://schema.org',
      '@type': 'MusicGroup',
      name: 'SoundLab — MathSonify',
      description: 'Proprietary equation compositions by MathSonify.',
      copyrightHolder: { '@type': 'Organization', name: 'MathSonify' },
    }
  : null;
---

{
  enabled ? (
    <BaseLayout
      title="SoundLab — Proprietary Equation Compositions | MathSonify"
      description={description}
    >
      {structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )}
      <Navigation />
      <SoundLabWorkspace client:only="react" />
      <Footer />
    </BaseLayout>
  ) : (
    <BaseLayout
      title="SoundLab - Something is being composed | MathSonify"
      description="A collection of original equation compositions, where mathematics is being turned into music."
      noindex
    >
      <Navigation />
      <FeatureBuildingState feature="soundLab" description={description} />
      <Footer />
    </BaseLayout>
  )
}
