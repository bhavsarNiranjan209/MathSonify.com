---
/**
 * /how-it-works — rebuilt as an experience rather than a specification.
 *
 * The previous version led with five numbered cards describing the pipeline.
 * That is the documentation voice, and it is exactly what this page is trying to
 * stop being: it told you what MathSonify does instead of letting you hear it.
 *
 * The structure now: prove it works first (a live equation above the fold), then
 * build the idea up through the transformation, then — lower down and collapsed
 * by default — preserve the original technical explanation for anyone who wants
 * it. Nothing was deleted; it was moved behind the demonstration.
 *
 * Performance: exactly ONE island on the page. Every static section is plain
 * Astro markup and ships zero JavaScript. The island owns one canvas and one rAF
 * loop. The section reveals are native `<details>`, so they are keyboard
 * accessible and need no script at all — no scroll-jacking, and no per-frame
 * work while the reader is only reading.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import HowItWorksDemo from '../components/HowItWorks/HowItWorksDemo.tsx';
---

<BaseLayout
  title="How Math Becomes Music - MathSonify"
  description="Type an equation, watch it become a curve, and hear that curve played. An interactive demonstration of how MathSonify turns mathematics into sound."
>
  <Navigation />

  <main class="pt-24 sm:pt-28 pb-20 px-4 sm:px-6 lg:px-8">
    <!--
      A very faint mathematical ground: two slow radial washes, pure CSS,
      non-interactive, behind everything.

      Deliberately almost invisible. The page already has a live canvas, a moving
      playhead and a live waveform, and the brief is explicit that the atmosphere
      must never compete with the content. Under reduced motion the animation is
      dropped entirely and only the static wash remains.
    -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="hwi-wash hwi-wash-a"></div>
      <div class="hwi-wash hwi-wash-b"></div>
    </div>

    <!-- ── HERO (H1) ── -->
    <section class="max-w-5xl mx-auto">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 border border-sc-accent/40 bg-sc-accent/15 rounded-full font-mono text-xs text-sc-accent mb-6"
      >
        Interactive demo
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-semibold text-sc-text tracking-tight leading-[1.05]">
        How math becomes music
      </h1>
      <p class="mt-5 text-base sm:text-lg text-sc-text-soft leading-relaxed max-w-2xl">
        Not by describing it. Type an equation, watch it become a curve, and hear
        that curve played. The scanner walks from left to right, and every point
        it passes becomes a note.
      </p>

      <!-- Glowing curve art + "A CURVE / A JOURNEY / A SOUND" -->
      <div class="mt-10 relative" aria-hidden="true">
        <canvas
          id="hero-canvas"
          class="w-full aspect-[16/9] max-h-[360px] rounded-lg"
          role="img"
          aria-label="Animated glowing curve demonstrating math-to-sound transformation"
        ></canvas>
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="flex flex-col items-center gap-1 text-center px-4">
            <span class="font-mono text-xs tracking-widest text-sc-accent/70 uppercase">A CURVE</span>
            <span class="font-mono text-xs tracking-widest text-sc-text-faint uppercase">/ A JOURNEY</span>
            <span class="font-mono text-xs tracking-widest text-sc-accent/70 uppercase">/ A SOUND</span>
          </div>
        </div>
      </div>
    </section>

    <script>
      // Hero canvas: animated glowing curve (static, no interaction)
      // Uses the same math-to-sound mapping concept: x → time, y → pitch
      const heroCanvas = document.getElementById('hero-canvas');
      if (heroCanvas) {
        const ctx = heroCanvas.getContext('2d');
        if (ctx) {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          let width = 0, height = 0;
          let raf = 0;
          let t = 0;
          let reducedMotion = false;

          const checkReducedMotion = () => {
            const query = window.matchMedia('(prefers-reduced-motion: reduce)');
            reducedMotion = query.matches;
            query.addEventListener?.('change', (e) => { reducedMotion = e.matches; });
          };
          checkReducedMotion();

          const resize = () => {
            const rect = heroCanvas.getBoundingClientRect();
            width = rect.width;
            height = rect.height;
            heroCanvas.width = Math.floor(width * dpr);
            heroCanvas.height = Math.floor(height * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          };
          resize();
          new ResizeObserver(resize).observe(heroCanvas);

          // Theme-aware colors
          const getColors = () => {
            const isDark = document.documentElement.classList.contains('dark') ||
              !document.documentElement.classList.contains('light');
            return isDark
              ? { glow: 'rgba(232,232,230,0.10)', accent: '#E8E8E6', accentSoft: 'rgba(232,232,230,0.55)', head: '#FFFFFF', trail: 'rgba(232,232,230,0.38)', ink: '#F2F2F0', faint: 'rgba(167,171,176,0.75)' }
              : { glow: 'rgba(27,36,48,0.07)', accent: '#1B2430', accentSoft: 'rgba(27,36,48,0.55)', head: '#1B2430', trail: 'rgba(27,36,48,0.34)', ink: '#1B2430', faint: 'rgba(64,64,64,0.78)' };
          };

          // Curve function: sin(x) + 0.5*sin(3x) — visually interesting
          const sampleCurve = (phase) => {
            const pts = [];
            const n = 400;
            for (let i = 0; i <= n; i++) {
              const x = -6 + (12 * i) / n;
              const y = Math.sin(x + phase) + 0.5 * Math.sin(3 * x + phase * 1.3);
              pts.push({ x, y });
            }
            return pts;
          };

          const draw = () => {
            raf = requestAnimationFrame(draw);
            if (width <= 0 || height <= 0) return;

            const ink = getColors();
            ctx.clearRect(0, 0, width, height);

            // Soft radial glow
            const glow = ctx.createRadialGradient(width / 2, height * 0.42, 0, width / 2, height * 0.42, Math.max(width, height) * 0.72);
            glow.addColorStop(0, ink.glow);
            glow.addColorStop(1, 'rgba(0,0,0,0)');
            ctx.fillStyle = glow;
            ctx.fillRect(0, 0, width, height);

            const pts = sampleCurve(t);
            const padX = 30, padY = 24;
            const usableW = Math.max(1, width - padX * 2);
            const usableH = Math.max(1, height - padY * 2);
            const project = (x, y) => ({
              sx: padX + ((x + 6) / 12) * usableW,
              sy: padY + usableH / 2 - y * (usableH / 2.6),
            });

            // Zero line
            const zero = project(0, 0);
            ctx.beginPath();
            ctx.moveTo(0, zero.sy);
            ctx.lineTo(width, zero.sy);
            ctx.strokeStyle = ink.faint;
            ctx.globalAlpha = 0.16;
            ctx.lineWidth = 1;
            ctx.stroke();
            ctx.globalAlpha = 1;

            // Full curve faint
            ctx.beginPath();
            let pen = false;
            for (const p of pts) {
              const { sx, sy } = project(p.x, p.y);
              if (pen) ctx.lineTo(sx, sy);
              else { ctx.moveTo(sx, sy); pen = true; }
            }
            ctx.strokeStyle = ink.faint;
            ctx.lineWidth = 1.6;
            ctx.stroke();

            // Travelling head + trail
            if (!reducedMotion) {
              t += 0.008;
              const headIndex = Math.floor((Math.sin(t * 0.5) * 0.5 + 0.5) * (pts.length - 1));
              const trailStart = Math.max(0, headIndex - 60);
              for (let i = trailStart; i < headIndex; i++) {
                const a = pts[i], b = pts[i + 1];
                const p1 = project(a.x, a.y), p2 = project(b.x, b.y);
                const age = (i - trailStart) / Math.max(1, headIndex - trailStart);
                ctx.beginPath();
                ctx.moveTo(p1.sx, p1.sy);
                ctx.lineTo(p2.sx, p2.sy);
                ctx.strokeStyle = ink.trail;
                ctx.globalAlpha = 0.55 * (1 - age);
                ctx.lineWidth = 3.4;
                ctx.stroke();
              }
              ctx.globalAlpha = 1;

              const head = project(pts[headIndex].x, pts[headIndex].y);
              ctx.beginPath();
              ctx.arc(head.sx, head.sy, 10, 0, Math.PI * 2);
              ctx.fillStyle = ink.glow;
              ctx.fill();
              ctx.beginPath();
              ctx.arc(head.sx, head.sy, 3.4, 0, Math.PI * 2);
              ctx.fillStyle = ink.head;
              ctx.fill();
            } else {
              // Reduced motion: static curve, no animation
              ctx.strokeStyle = ink.accent;
              ctx.lineWidth = 2.2;
              ctx.stroke();
            }
          };

          draw();

          // Theme change handling
          const onThemeChange = () => {
            // Just trigger a redraw by letting the next frame pick up new colors
          };
          document.addEventListener('astro:after-swap', onThemeChange);
          // Cleanup on page unload (not strictly needed for SPA but good practice)
          window.addEventListener('beforeunload', () => cancelAnimationFrame(raf));
        }
      }
    </script>

    <!-- ── TWO-CARD DEMO (H2 + H3) ── -->
    <section class="max-w-5xl mx-auto mt-10 sm:mt-14">
      <HowItWorksDemo client:load />
    </section>

    <!-- ── the transformation, stated as a journey ── -->
    <section class="max-w-5xl mx-auto mt-24 sm:mt-32">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-sc-text">
        The same journey, every time
      </h2>
      <p class="mt-3 text-sm text-sc-text-soft leading-relaxed max-w-2xl">
        Everything above is one transformation, whether the equation is
        <code class="font-mono text-sc-text">sin(x)</code> or something far less
        forgiving.
      </p>

      <!--
        Native `<details>` rather than a scroll-triggered reveal. It works with
        no JavaScript, is keyboard accessible for free, and cannot trap the
        reader the way a scroll hijack would. Each row also reads as a complete
        sentence when collapsed, so the section still communicates the shape of
        the pipeline without being opened.
      -->
      <ol class="mt-8 space-y-2">
        {
          [
            ['Mathematics', 'You write an equation. It is parsed into a tree and never executed as code.'],
            ['Geometry', 'The curve is sampled into points, each carrying its height, slope and curvature.'],
            ['Motion', 'A playhead sweeps left to right. Position in x becomes position in time.'],
            ['Sound', 'Height becomes pitch, steepness opens the filter, and the curve is heard.'],
            ['Music', 'Snapped to a scale, the same mathematics becomes something you might replay.'],
          ].map(([title, body], i) => (
            <li>
              <details class="group panel px-4 sm:px-5 py-4 rounded">
                <summary class="flex items-center gap-4 cursor-pointer list-none min-h-[44px]">
                  <span class="font-mono text-xs text-sc-text-faint w-6 shrink-0">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="font-serif text-lg text-sc-text flex-1">{title}</span>
                  <span class="hwi-plus" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 text-sm text-sc-text-soft leading-relaxed pl-10">{body}</p>
              </details>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- PLACEHOLDER_UNDER_THE_HOOD -->

    <!--
      CLOSING — two ways to go deeper, then the same CTA the rest of the site
      ends on. Plain Astro markup: zero JavaScript ships for this section, which
      keeps the page's "one island" rule intact.
    -->
    <section class="max-w-5xl mx-auto mt-24 sm:mt-32" aria-labelledby="hwi-deeper">
      <h2 id="hwi-deeper" class="font-serif text-2xl sm:text-3xl font-semibold text-sc-text">
        Where this goes next
      </h2>
      <p class="mt-3 text-sm text-sc-text-soft leading-relaxed max-w-2xl">
        You have heard one curve become sound. The rest of MathSonify points the
        same transformation at everything else.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <a
          href="/scientists"
          class="panel group flex flex-col p-6 rounded hover:border-sc-accent/50 transition-colors duration-300"
        >
          <span class="font-mono text-[10px] uppercase tracking-wider text-sc-accent">
            hear the masters
          </span>
          <span class="mt-2 font-serif text-xl text-sc-text">
            Scientists & mathematicians
          </span>
          <span class="mt-2 text-sm text-sc-text-soft leading-relaxed flex-1">
            Euler, Fourier, Curie and a hundred more — each with the equations
            they left behind, ready to hear.
          </span>
          <span class="mt-5 font-mono text-xs text-sc-text-soft transition-colors group-hover:text-sc-accent">
            Browse the archive <span aria-hidden="true">→</span>
          </span>
        </a>

        <a
          href="/equations"
          class="panel group flex flex-col p-6 rounded hover:border-sc-accent/50 transition-colors duration-300"
        >
          <span class="font-mono text-[10px] uppercase tracking-wider text-sc-accent">
            mathematical catalog
          </span>
          <span class="mt-2 font-serif text-xl text-sc-text">
            Equation reference
          </span>
          <span class="mt-2 text-sm text-sc-text-soft leading-relaxed flex-1">
            Every function MathSonify can parse, what it sounds like, and how each
            property of it becomes a note.
          </span>
          <span class="mt-5 font-mono text-xs text-sc-text-soft transition-colors group-hover:text-sc-accent">
            Open the reference <span aria-hidden="true">→</span>
          </span>
        </a>
      </div>
    </section>

    <!-- Final CTA — the closing action used across the site. -->
    <div class="max-w-5xl mx-auto mt-16 text-center">
      <a href="/studio" class="btn-primary inline-flex items-center px-8 py-3.5 text-base">
        Open the Studio
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
