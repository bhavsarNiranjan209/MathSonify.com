---
/**
 * /how-it-works — rebuilt as an experience rather than a specification.
 *
 * The previous version led with five numbered cards describing the pipeline.
 * That is the documentation voice, and it is exactly what this page is trying to
 * stop being: it told you what MathSonify does instead of letting you hear it.
 *
 * The structure now: prove it works first (a live equation above the fold), then
 * build the idea up through the transformation, then — lower down and collapsed
 * by default — preserve the original technical explanation for anyone who wants
 * it. Nothing was deleted; it was moved behind the demonstration.
 *
 * Performance: exactly ONE island on the page. Every static section is plain
 * Astro markup and ships zero JavaScript. The island owns one canvas and one rAF
 * loop. The section reveals are native `<details>`, so they are keyboard
 * accessible and need no script at all — no scroll-jacking, and no per-frame
 * work while the reader is only reading.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import HowItWorksDemo from '../components/HowItWorks/HowItWorksDemo.tsx';
---

<BaseLayout
  title="How Math Becomes Music - MathSonify"
  description="Type an equation, watch it become a curve, and hear that curve played. An interactive demonstration of how MathSonify turns mathematics into sound."
>
  <Navigation />

  <main class="pt-24 sm:pt-28 pb-20 px-4 sm:px-6 lg:px-8">
    <!--
      A very faint mathematical ground: two slow radial washes, pure CSS,
      non-interactive, behind everything.

      Deliberately almost invisible. The page already has a live canvas, a moving
      playhead and a live waveform, and the brief is explicit that the atmosphere
      must never compete with the content. Under reduced motion the animation is
      dropped entirely and only the static wash remains.
    -->
    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="hwi-wash hwi-wash-a"></div>
      <div class="hwi-wash hwi-wash-b"></div>
    </div>

    <!-- ── HERO (H1) ── -->
    <section class="max-w-5xl mx-auto relative py-11 sm:py-12 min-h-[340px]">
      <!-- Animated curve art on the right: a scan line sweeps the curve and
           three nodes pulse as it passes — the hero curve moves, as briefed. -->
      <div class="hwi-hero-art" aria-hidden="true"><canvas id="heroArt"></canvas></div>
      <div class="hwi-hero-aside" aria-hidden="true">
        <div class="font-instrument italic text-[19px] mb-[22px]">f(x)</div>
        <span class="hwi-cap">A curve</span>
        <span class="hwi-cap">A journey</span>
        <span class="hwi-cap">A sound</span>
        <hr class="w-[26px] border-0 border-t border-sc-line/25 mt-2.5" />
      </div>
      <span
        class="inline-flex font-mono text-[10.5px] tracking-[0.2em] uppercase border border-sc-line/25 bg-sc-surface rounded-full px-3.5 py-1.5 mb-[18px] relative"
      >
        Try it yourself
      </span>
      <h1 class="font-instrument font-normal text-[clamp(46px,7vw,64px)] leading-[0.98] tracking-[-0.015em] text-sc-text m-0 mb-5 max-w-[6.4em] relative">
        How math becomes music
      </h1>
      <p class="relative text-sc-text opacity-80 text-base leading-[1.65] max-w-[46ch] m-0">
        Not by describing it. Type an equation, watch it become a curve, and hear
        that curve played. The scanner walks from left to right, and every point
        it passes becomes a note.
      </p>
    </section>

    <script>
      // Hero art: one big glowing curve, three nodes, a scan line, fanned ribbons.
      // Ported from the redesign mockup; colours read from the site's own
      // --sc-text token so it follows the light/dark theme live, and the
      // scan line keeps the curve moving (reduced motion: static frame).
      const heroCanvas = document.getElementById('heroArt');
      if (heroCanvas) {
        const ctx = heroCanvas.getContext('2d');
        if (ctx) {
          const TAU = Math.PI * 2;
          const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          let width = 0, height = 0, raf = 0;

          const inkTriplet = () => {
            const v = getComputedStyle(document.documentElement).getPropertyValue('--sc-text').trim();
            return v ? v.split(/\s+/).join(', ') : '242, 242, 240';
          };
          const isLight = () => document.documentElement.dataset.theme === 'light';
          const ink = (a) => `rgba(${inkTriplet()}, ${Math.min(1, isLight() ? a * 1.2 : a)})`;
          const halo = (a) => ink(a * (isLight() ? 0.35 : 1));
          const smooth = (a, b, v) => { const t = Math.min(1, Math.max(0, (v - a) / (b - a))); return t * t * (3 - 2 * t); };

          const resize = () => {
            const rect = heroCanvas.getBoundingClientRect();
            width = rect.width; height = rect.height;
            heroCanvas.width = Math.floor(width * dpr);
            heroCanvas.height = Math.floor(height * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          };
          resize();
          new ResizeObserver(resize).observe(heroCanvas);

          const mainY = (u, H) => {
            const g = u < 0.23 ? Math.exp(-Math.pow((u - 0.23) / 0.16, 2)) : Math.exp(-Math.pow((u - 0.23) / 0.3, 2));
            return H * (0.8 - 0.58 * g);
          };

          const draw = (now) => {
            raf = requestAnimationFrame(draw);
            if (width <= 0 || height <= 0) return;
            const t = RM ? 0 : now / 1000;
            const W = width, H = height;
            ctx.clearRect(0, 0, W, H);

            // Faint grid, right half only
            ctx.strokeStyle = ink(0.05); ctx.lineWidth = 1; ctx.beginPath();
            for (let gx = W * 0.5; gx < W; gx += 26) { ctx.moveTo(gx, 0); ctx.lineTo(gx, H * 0.62); }
            for (let gy = 0; gy < H * 0.62; gy += 26) { ctx.moveTo(W * 0.5, gy); ctx.lineTo(W, gy); }
            ctx.stroke();

            // Scan line sweeping the curve
            const su = 0.49 + (RM ? 0 : 0.012 * Math.sin(t * 0.6)), sx = W * su;
            const g = ctx.createLinearGradient(0, 0, 0, H * 0.9);
            g.addColorStop(0, ink(0)); g.addColorStop(0.35, ink(0.55)); g.addColorStop(1, ink(0));
            ctx.fillStyle = g; ctx.fillRect(sx - 0.5, 0, 1, H * 0.9);

            // Fanned ribbons under the curve
            const N = 46;
            for (let k = N; k >= 1; k--) {
              const a = 0.2 * (1 - k / N) + 0.02;
              ctx.strokeStyle = ink(a); ctx.lineWidth = 1; ctx.beginPath();
              for (let i = 0; i <= 120; i++) {
                const u = i / 120;
                const off = (k / N) * H * 0.16 * smooth(0.22, 0.95, u) * (1 + 0.18 * Math.sin(u * 9 + k * 0.31 + t * 0.7));
                const x = W * u, y = mainY(u, H) + off;
                i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
              }
              ctx.stroke();
            }

            // The curve itself, three weights
            [[3.2, 0.2], [1.8, 0.4], [1, 1]].forEach(([lw, a]) => {
              ctx.strokeStyle = ink(a * 0.55 + (a === 1 ? 0.45 : 0));
              ctx.lineWidth = lw; ctx.lineCap = 'round'; ctx.beginPath();
              for (let i = 0; i <= 160; i++) {
                const u = i / 160;
                i ? ctx.lineTo(W * u, mainY(u, H)) : ctx.moveTo(W * u, mainY(u, H));
              }
              ctx.stroke();
            });

            // Three pulsing nodes on the curve
            [0.23, 0.49, 0.68].forEach((u, i) => {
              const x = W * u, y = mainY(u, H);
              const p = RM ? 0 : (Math.sin(t * 1.6 + i * 1.4) + 1) / 2;
              const r = 3.5 + (i === 1 ? 1 : 0);
              const gr = ctx.createRadialGradient(x, y, 0, x, y, 16 + p * 8);
              gr.addColorStop(0, halo(0.5)); gr.addColorStop(1, ink(0));
              ctx.fillStyle = gr; ctx.beginPath(); ctx.arc(x, y, 16 + p * 8, 0, TAU); ctx.fill();
              ctx.fillStyle = ink(1); ctx.beginPath(); ctx.arc(x, y, r, 0, TAU); ctx.fill();
            });
          };

          draw(0);
          window.addEventListener('beforeunload', () => cancelAnimationFrame(raf));
        }
      }
    </script>

    <!-- ── BARE 3D DEMO — the curve of sin(x), no card, no controls ── -->
    <section class="max-w-5xl mx-auto mt-10 sm:mt-14">
      <HowItWorksDemo client:load />
    </section>

    <!-- ── the transformation, stated as a journey ── -->
    <section class="max-w-5xl mx-auto mt-24 sm:mt-32">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-sc-text">
        The same journey, every time
      </h2>
      <p class="mt-3 text-sm text-sc-text-soft leading-relaxed max-w-2xl">
        Everything above is one transformation, whether the equation is
        <code class="font-mono text-sc-text">sin(x)</code> or something far less
        forgiving.
      </p>

      <!--
        Native `<details>` rather than a scroll-triggered reveal. It works with
        no JavaScript, is keyboard accessible for free, and cannot trap the
        reader the way a scroll hijack would. Each row also reads as a complete
        sentence when collapsed, so the section still communicates the shape of
        the pipeline without being opened.
      -->
      <ol class="mt-8 space-y-2">
        {
          [
            ['Mathematics', 'You write an equation. It is parsed into a tree and never executed as code.'],
            ['Geometry', 'The curve is sampled into points, each carrying its height, slope and curvature.'],
            ['Motion', 'A playhead sweeps left to right. Position in x becomes position in time.'],
            ['Sound', 'Height becomes pitch, steepness opens the filter, and the curve is heard.'],
            ['Music', 'Snapped to a scale, the same mathematics becomes something you might replay.'],
          ].map(([title, body], i) => (
            <li>
              <details class="group panel px-4 sm:px-5 py-4 rounded">
                <summary class="flex items-center gap-4 cursor-pointer list-none min-h-[44px]">
                  <span class="font-mono text-xs text-sc-text-faint w-6 shrink-0">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="font-serif text-lg text-sc-text flex-1">{title}</span>
                  <span class="hwi-plus" aria-hidden="true">+</span>
                </summary>
                <p class="mt-3 text-sm text-sc-text-soft leading-relaxed pl-10">{body}</p>
              </details>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- PLACEHOLDER_UNDER_THE_HOOD -->

    <!-- ── EXPLORE: continue the journey (redesign mockup) ── -->
    <section class="max-w-5xl mx-auto mt-24 sm:mt-32 relative" aria-labelledby="hwi-deeper">
      <span class="inline-flex font-mono text-[10.5px] tracking-[0.2em] uppercase border border-sc-line/25 bg-sc-surface rounded-full px-3.5 py-1.5">
        Explore
      </span>
      <h2 id="hwi-deeper" class="font-instrument font-normal text-[clamp(34px,5vw,46px)] leading-[1.05] mt-3.5 mb-2.5">
        Continue the journey
      </h2>
      <p class="text-sc-text opacity-80 max-w-[48ch] leading-[1.6] text-[15.5px] mb-[26px]">
        Try a challenge, explore more equations, or learn from the scientists who laid the foundations. Same transformation, different perspectives.
      </p>
      <div class="hwi-eside" aria-hidden="true">
        <span class="hwi-cap">One idea</span>
        <span class="hwi-cap">Many perspectives</span>
        <hr class="w-[26px] border-0 border-t border-sc-line/25 mt-2" />
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <a class="hwi-go group" href="/guess">
          <canvas id="hwi-a1" aria-hidden="true"></canvas>
          <span class="hwi-go-n">01</span>
          <svg class="hwi-go-ic" viewBox="0 0 24 24"><path d="M6 11h4M8 9v4M15 12h.01M18 10h.01"/><path d="M17.3 5H6.7a4 4 0 0 0-3.9 3.2l-1 5.6A3 3 0 0 0 4.7 17c.9 0 1.6-.4 2.2-1l1.4-1.4h7.4L17.1 16c.6.6 1.3 1 2.2 1a3 3 0 0 0 2.9-3.2l-1-5.6A4 4 0 0 0 17.3 5z"/></svg>
          <h3>Guess</h3>
          <p>Listen to the sound and guess the equation behind it.</p>
          <span class="hwi-go-arr" aria-hidden="true">⟶</span>
        </a>
        <a class="hwi-go group" href="/equations">
          <canvas id="hwi-a2" aria-hidden="true"></canvas>
          <span class="hwi-go-n">02</span>
          <svg class="hwi-go-ic" viewBox="0 0 24 24"><path d="M12 7v13M3 5a1 1 0 0 1 1-1h5a3 3 0 0 1 3 3 3 3 0 0 1 3-3h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 2 3 3 0 0 0-3-2H4a1 1 0 0 1-1-1z"/></svg>
          <h3>Equations</h3>
          <p>Explore a growing library of equations and see how each one sounds.</p>
          <span class="hwi-go-arr" aria-hidden="true">⟶</span>
        </a>
        <a class="hwi-go group" href="/scientists">
          <canvas id="hwi-a3" aria-hidden="true"></canvas>
          <span class="hwi-go-n">03</span>
          <svg class="hwi-go-ic" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20v-1a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v1"/><circle cx="17" cy="9" r="2.4"/><path d="M17.5 14a4 4 0 0 1 3.5 4v1"/></svg>
          <h3>Scientists</h3>
          <p>Learn about the mathematicians and scientists behind these ideas.</p>
          <span class="hwi-go-arr" aria-hidden="true">⟶</span>
        </a>
      </div>
      <div class="flex justify-center mt-[34px] mb-[54px]">
        <a href="/studio" class="btn-primary inline-flex items-center gap-2.5 px-7 py-4 text-[15px]">
          Open the Studio <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <script>
      // Explore-card art (redesign mockup): one line drawing per card —
      // waves for Guess, a ribbon for Equations, a torus for Scientists.
      // Static at rest; on hover the art comes alive and follows the cursor:
      // the waves ripple and sway, the ribbon flows, the torus rotates a bit.
      // Redrawn on resize and on theme change; colours from --sc-text.
      // Respects prefers-reduced-motion (no animation, static art only).
      (() => {
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const cards = [
          { id: 'hwi-a1', kind: 'waves' },
          { id: 'hwi-a2', kind: 'ribbon' },
          { id: 'hwi-a3', kind: 'torus' },
        ].map(({ id, kind }) => {
          const canvas = document.getElementById(id);
          if (!canvas) return null;
          return { canvas, kind, el: canvas.closest('.hwi-go'), hover: false, mx: 0, my: 0, sx: 0, sy: 0, phase: 0, active: false };
        }).filter(Boolean);
        if (!cards.length) return;
        const TAU = Math.PI * 2;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const inkTriplet = () => {
          const v = getComputedStyle(document.documentElement).getPropertyValue('--sc-text').trim();
          return v ? v.split(/\s+/).join(', ') : '242, 242, 240';
        };
        const isLight = () => document.documentElement.dataset.theme === 'light';
        const ink = (a) => `rgba(${inkTriplet()}, ${Math.min(1, isLight() ? a * 1.2 : a)})`;
        const fit = (c) => {
          const w = c.clientWidth, h = c.clientHeight;
          if (!w || !h) return null;
          const pw = Math.round(w * dpr), ph = Math.round(h * dpr);
          const x = c.getContext('2d');
          if (c.width !== pw || c.height !== ph) { c.width = pw; c.height = ph; }
          x.setTransform(dpr, 0, 0, dpr, 0, 0);
          return { x, w, h };
        };
        // phase = flowing time (advances while hovered); sx/sy = smoothed
        // cursor, -0.5..0.5 from the card centre, eased back to 0 at rest.
        const artWaves = (c, W, H, s) => {
          for (let k = 0; k < 30; k++) {
            c.strokeStyle = ink(0.05 + 0.2 * (1 - Math.abs(k - 15) / 15)); c.lineWidth = 1; c.beginPath();
            for (let i = 0; i <= 100; i++) {
              const u = i / 100, x = W * (0.1 + 0.9 * u) + s.sx * 14 * Math.sin(u * Math.PI), env = Math.sin(u * Math.PI);
              const y = H * 0.55 + Math.sin(u * 7 + k * 0.2 + s.phase) * H * 0.2 * env * (1 - u * 0.2) + (k - 15) * 3.2 * env + s.sy * 10 * env;
              i ? c.lineTo(x, y) : c.moveTo(x, y);
            }
            c.stroke();
          }
        };
        const artRibbon = (c, W, H, s) => {
          for (let k = 0; k < 26; k++) {
            c.strokeStyle = ink(0.06 + 0.16 * (1 - k / 26)); c.lineWidth = 1; c.beginPath();
            for (let i = 0; i <= 100; i++) {
              const u = i / 100, x = W * u + s.sx * 10 * Math.sin(u * Math.PI);
              const y = H * 0.62 - Math.sin(u * TAU * 0.8 + 0.4 + s.phase) * H * 0.22 * (0.4 + u * 0.8) + k * 3 - (1 - u) * k * 2 + s.sy * 8 * Math.sin(u * Math.PI);
              i ? c.lineTo(x, y) : c.moveTo(x, y);
            }
            c.stroke();
          }
        };
        const artTorus = (c, W, H, s) => {
          const cx = W * 0.6, cy = H * 0.45, R = Math.min(W, H) * 0.3, r = R * 0.46;
          const tx = 1.0 + s.sy * 0.7, tz = 0.35 + s.sx * 0.9;
          const rot = (p) => {
            const [x, y, z] = p;
            const y1 = y * Math.cos(tx) - z * Math.sin(tx), z1 = y * Math.sin(tx) + z * Math.cos(tx);
            const x2 = x * Math.cos(tz) - y1 * Math.sin(tz), y2 = x * Math.sin(tz) + y1 * Math.cos(tz);
            return [cx + x2, cy + y2, z1];
          };
          const P = (u, v) => rot([(R + r * Math.cos(v)) * Math.cos(u), (R + r * Math.cos(v)) * Math.sin(u), r * Math.sin(v)]);
          c.lineWidth = 1;
          for (let a = 0; a < 26; a++) {
            c.strokeStyle = ink(0.22); c.beginPath();
            for (let i = 0; i <= 40; i++) { const p = P((a / 26) * TAU, (i / 40) * TAU); i ? c.lineTo(p[0], p[1]) : c.moveTo(p[0], p[1]); }
            c.stroke();
          }
          for (let b = 0; b < 14; b++) {
            c.strokeStyle = ink(0.3); c.beginPath();
            for (let i = 0; i <= 60; i++) { const p = P((i / 60) * TAU, (b / 14) * TAU); i ? c.lineTo(p[0], p[1]) : c.moveTo(p[0], p[1]); }
            c.stroke();
          }
        };
        const drawOne = (card) => {
          const f = fit(card.canvas);
          if (!f) return;
          f.x.clearRect(0, 0, f.w, f.h);
          (card.kind === 'waves' ? artWaves : card.kind === 'ribbon' ? artRibbon : artTorus)(f.x, f.w, f.h, card);
        };
        const drawAll = () => { for (const card of cards) drawOne(card); };
        // Animation loop: runs only while a card is hovered or settling back.
        let raf = 0;
        const tick = () => {
          raf = 0;
          let busy = false;
          for (const card of cards) {
            card.sx += ((card.hover ? card.mx : 0) - card.sx) * 0.12;
            card.sy += ((card.hover ? card.my : 0) - card.sy) * 0.12;
            if (card.hover) card.phase += 0.05;
            const moving = Math.abs(card.sx) > 0.002 || Math.abs(card.sy) > 0.002 || card.hover;
            if (moving) { card.active = true; busy = true; drawOne(card); }
            else if (card.active) { card.active = false; card.sx = 0; card.sy = 0; drawOne(card); }
          }
          if (busy) raf = requestAnimationFrame(tick);
        };
        const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };
        if (!reduceMotion) {
          for (const card of cards) {
            if (!card.el) continue;
            card.el.addEventListener('pointerenter', () => { card.hover = true; kick(); });
            card.el.addEventListener('pointermove', (e) => {
              const r = card.el.getBoundingClientRect();
              card.mx = (e.clientX - r.left) / r.width - 0.5;
              card.my = (e.clientY - r.top) / r.height - 0.5;
            });
            card.el.addEventListener('pointerleave', () => { card.hover = false; kick(); });
          }
        }
        drawAll();
        addEventListener('resize', drawAll);
        new MutationObserver(drawAll).observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'data-theme'] });
      })();
    </script>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero art, per the redesign mockup: the curve panel sits on the right,
     fading into the text on its left edge; on mobile it stacks below. */
  .hwi-hero-art { position: absolute; right: -60px; top: -58px; width: 68%; height: 430px; pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 30%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 30%, #000 100%); }
  .hwi-hero-art canvas { width: 100%; height: 100%; display: block; }
  .hwi-hero-aside { position: absolute; right: 0; top: 20px; text-align: left; pointer-events: none; }
  .hwi-cap { display: block; font-family: "JetBrains Mono", monospace; font-size: 10px; letter-spacing: .18em;
    text-transform: uppercase; color: rgb(var(--sc-text-faint)); line-height: 2.1; }
  @media (max-width: 820px) {
    .hwi-hero-art { position: relative; right: 0; top: 0; width: 100%; height: 240px; margin-top: 10px;
      -webkit-mask-image: none; mask-image: none; }
    .hwi-hero-aside { display: none; }
  }

  /* Explore cards, per the redesign mockup: canvas line-art behind the text,
     a number + icon + serif title, and a lift on hover. */
  .hwi-eside { position: absolute; right: 0; top: 34px; text-align: left; }
  .hwi-go { position: relative; overflow: hidden; display: flex; flex-direction: column; min-height: 222px;
    background: rgb(var(--sc-surface)); border: 1px solid rgb(var(--sc-line) / 0.15); border-radius: 14px;
    padding: 20px; text-decoration: none; color: rgb(var(--sc-text));
    transition: border-color .3s, transform .3s; }
  .hwi-go:hover { border-color: rgb(var(--sc-accent)); transform: translateY(-3px); }
  .hwi-go canvas { position: absolute; right: 0; top: 0; width: 78%; height: 100%; opacity: .8; transition: opacity .3s; }
  .hwi-go:hover canvas { opacity: 1; }
  .hwi-go > *:not(canvas) { position: relative; }
  .hwi-go-n { font-family: "JetBrains Mono", monospace; font-size: 11px; color: rgb(var(--sc-text-faint)); margin-bottom: 18px; }
  .hwi-go-ic { width: 26px; height: 26px; stroke: currentColor; fill: none; stroke-width: 1.5; margin-bottom: 12px; }
  .hwi-go h3 { font-family: "Instrument Serif", serif; font-weight: 400; font-size: 25px; margin: 0 0 8px; }
  .hwi-go p { margin: 0; color: rgb(var(--sc-text-soft)); font-size: 13.5px; line-height: 1.55; max-width: 20ch; }
  .hwi-go-arr { margin-top: auto; padding-top: 14px; transition: transform .3s; font-size: 20px; }
  .hwi-go:hover .hwi-go-arr { transform: translateX(6px); }
  @media (max-width: 820px) {
    .hwi-eside { display: none; }
